---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DiscussionComposer from '../components/discussion/DiscussionComposer';
---

<DashboardLayout title="Discussion" currentPath="/discussion">
  <div class="mx-auto max-w-6xl animate-fade-in px-1 pb-10 sm:px-0 md:pb-14">
    <section class="rounded-[1.75rem] border border-gray-200/90 bg-[#ECEFF1]/40 p-1 shadow-sm ring-1 ring-black/[0.03] sm:p-2">
      <DiscussionComposer client:load />
    </section>
  </div>
</DashboardLayout>
