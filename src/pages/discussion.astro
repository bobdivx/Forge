---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DiscussionComposer from '../components/discussion/DiscussionComposer';
---

<DashboardLayout title="Hub de Communication (Swarm)" currentPath="/discussion">
  
  <div class="mx-auto max-w-6xl animate-fade-in px-1 pb-6 sm:px-0">
    <div class="flex items-end justify-between flex-wrap gap-4 mb-2">
      <div>
        <h1 class="text-4xl font-bold mb-2 text-gray-900">Hub Swarm</h1>
        <p class="text-gray-500 text-sm">
          Communiquez en direct avec vos agents. Envoyez vos directives, partagez vos remarques ou demandez un point de situation.
        </p>
      </div>
      <div class="flex gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
          <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
          Gateway OpenClaw Connectée
        </span>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl animate-fade-in px-1 pb-10 sm:px-0 md:pb-14">
    <section class="rounded-[1.75rem] border border-gray-200/90 bg-[#ECEFF1]/40 p-1 shadow-sm ring-1 ring-black/[0.03] sm:p-2">
      <DiscussionComposer client:load />
    </section>
  </div>
</DashboardLayout>
