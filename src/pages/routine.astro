---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import RoutinePanel from '../components/routine/RoutinePanel';
---

<DashboardLayout title="Routine" currentPath="/routine">
  <div class="max-w-4xl mx-auto space-y-6">
    <div>
      <h1 class="text-4xl font-bold mb-2 text-gray-900">Routine</h1>
      <p class="text-gray-500 text-sm">
        Pilotage des routines agents Forge: surveillance des dépôts GitHub et propositions d'améliorations régulières.
      </p>
    </div>

    <RoutinePanel client:load />
  </div>
</DashboardLayout>
