---
// @ts-nocheck
import '../styles/global.css';
import MobileMenu from "../components/layout/MobileMenu";
import OpenClawLayoutBadge from "../components/layout/OpenClawLayoutBadge";
const { title, currentPath = Astro.url.pathname } = Astro.props;
const userEmail = String(Astro.locals?.user?.email ?? 'utilisateur');
const userInitial = userEmail.charAt(0).toUpperCase();
const userName = userEmail.split('@')[0];

const menuItems = [
  {
    name: "Vue d'ensemble",
    path: "/dashboard",
    icon: `<path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>`,
    solid: true,
    match: ["/dashboard"],
    badge: null,
  },
  {
    name: "L'Équipe",
    path: "/agents",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>`,
    match: ["/agents", "/swarm"],
    badge: null,
  },
  {
    name: "Flux Swarm",
    path: "/agents/flux",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
    match: ["/agents/flux"],
    badge: null,
  },
  {
    name: "Projets",
    path: "/apps",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-10.5v9"/>`,
    match: ["/apps"],
    badge: null,
  },
  {
    name: "Discussion",
    path: "/discussion",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>`,
    match: ["/discussion"],
    badge: null,
  },
  {
    name: "Carnet de bord",
    path: "/work",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>`,
    match: ["/work", "/reports", "/needs"],
    badge: null,
  },
  {
    name: "Coûts & Budget",
    path: "/costs",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
    match: ["/costs"],
    badge: null,
  },
  {
    name: "Approbations",
    path: "/orchestration",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
    match: ["/orchestration"],
    badge: null,
  },
  {
    name: "Sant\u00e9",
    path: "/health",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>`,
    match: ["/health"],
    badge: null,
  },
];

const generalItems = [
  {
    name: "Paramètres",
    path: "/settings",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>`,
    match: ["/settings", "/ai", "/help"],
  },
  {
    name: "Aide",
    path: "/help",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
    match: ["/help"],
  },
  {
    name: "Déconnexion",
    path: "/api/auth/logout",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>`,
    match: [],
  },
];
---

<html lang="fr" class="h-full" data-theme="forge">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | DevForge</title>
    <style>
      body { background-color: #F4F7F5; }
    </style>
  </head>
  <body class="flex gap-4 p-3 md:p-4 lg:gap-5 min-h-screen font-sans text-gray-800 antialiased" style="background:#F4F7F5">

    <!-- ── Sidebar ──────────────────────────────────────────────────── -->
    <aside class="hidden md:flex w-64 shrink-0 bg-white rounded-[2rem] p-6 flex-col justify-between shadow-sm" style="min-height: calc(100vh - 2rem)">
      <div>
        <!-- Logo -->
        <div class="flex items-center gap-3 mb-10">
          <div class="w-8 h-8 rounded-full border-[3px] border-[#3BAE61] flex items-center justify-center cursor-pointer" onclick="window.location.href='/'">
            <div class="w-3 h-3 bg-[#175B37] rounded-full"></div>
          </div>
          <span class="text-xl font-bold text-gray-900">DevForge</span>
        </div>

        <!-- MENU -->
        <p class="text-xs font-semibold text-gray-400 mb-4 tracking-wider">MENU</p>
        <nav class="flex flex-col gap-1 mb-8">
          {menuItems.map(item => {
            const isActive = item.match.some(m => {
              if (m === '/agents' && (currentPath === '/agents/flux' || currentPath.startsWith('/agents/flux/'))) return false;
              return currentPath === m || currentPath.startsWith(m);
            });
            return (
              <a
                href={item.path}
                class={`flex justify-between items-center px-4 py-2.5 rounded-xl font-medium text-sm transition-colors ${
                  isActive
                    ? 'bg-[#E9F3EB] text-[#175B37] font-semibold'
                    : 'text-gray-500 hover:bg-gray-50 hover:text-gray-700'
                }`}
              >
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 shrink-0" fill={isActive ? 'currentColor' : 'none'} stroke={isActive ? 'none' : 'currentColor'} viewBox="0 0 24 24">
                    <Fragment set:html={item.icon} />
                  </svg>
                  {item.name}
                </div>
                {item.badge && (
                  <span class="bg-[#175B37] text-white text-[10px] px-2 py-0.5 rounded-full font-semibold">{item.badge}</span>
                )}
              </a>
            );
          })}
        </nav>

        <!-- GENERAL -->
        <p class="text-xs font-semibold text-gray-400 mb-4 tracking-wider">GENERAL</p>
        <nav class="flex flex-col gap-1">
          {generalItems.map(item => {
            const isActive = item.match.some(m => {
              if (m === '/agents' && (currentPath === '/agents/flux' || currentPath.startsWith('/agents/flux/'))) return false;
              return currentPath === m || currentPath.startsWith(m);
            });
            return (
              <a
                href={item.path}
                class={`flex items-center gap-3 px-4 py-2.5 rounded-xl font-medium text-sm transition-colors ${
                  isActive
                    ? 'bg-[#E9F3EB] text-[#175B37] font-semibold'
                    : 'text-gray-500 hover:bg-gray-50 hover:text-gray-700'
                }`}
              >
                <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <Fragment set:html={item.icon} />
                </svg>
                {item.name}
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Download / OpenClaw Banner -->
      <div class="bg-gradient-to-br from-[#0B2717] to-[#175B37] rounded-[1.5rem] p-5 text-white relative overflow-hidden mt-8">
        <div class="absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_bottom_right,_var(--tw-gradient-stops))] from-white via-transparent to-transparent"></div>
        <div class="relative z-10">
          <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center mb-4">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h4 class="font-semibold text-base leading-tight mb-1">Accéder à OpenClaw</h4>
          <p class="text-[11px] text-gray-300 mb-4">Interface de contrôle avancée</p>
          <a href="/settings" class="block w-full py-2 bg-[#175B37] text-white text-xs font-medium rounded-full text-center shadow-sm hover:bg-[#0B2717] transition-colors">
            Ouvrir
          </a>
        </div>
      </div>
    </aside>

    <!-- ── Main ──────────────────────────────────────────────────────── -->
    <main class="flex-1 flex flex-col gap-4 md:gap-5 min-w-0 overflow-y-auto" style="max-height: calc(100vh - 1.5rem)">

      <!-- Top header -->
      <header class="bg-white rounded-2xl px-4 md:px-5 py-3 shadow-sm flex items-center justify-between gap-3 shrink-0">
        <!-- Left: mobile menu + search -->
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <MobileMenu client:load currentPath={currentPath} />
          <div class="hidden sm:flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-full px-4 py-2 flex-1 max-w-xs">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input
              type="text"
              placeholder="Rechercher…"
              class="bg-transparent border-none focus:outline-none text-sm w-full text-gray-600 placeholder-gray-400"
            />
            <kbd class="shrink-0 text-[10px] bg-gray-200 text-gray-500 px-1.5 py-0.5 rounded">⌘F</kbd>
          </div>
        </div>

        <!-- Right: icons + user -->
        <div class="flex items-center gap-2 shrink-0">
          <button class="w-9 h-9 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition-colors">
            <svg class="w-4.5 h-4.5 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </button>
          <button class="w-9 h-9 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            </svg>
          </button>
          <div class="hidden sm:block">
            <OpenClawLayoutBadge client:load />
          </div>
          <!-- Avatar + nom -->
          <div class="flex items-center gap-2.5 pl-1">
            <div class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm text-white shrink-0" style="background:#175B37">
              {userInitial}
            </div>
            <div class="hidden lg:block text-sm leading-tight">
              <p class="font-semibold text-gray-800">{userName}</p>
              <p class="text-gray-400 text-xs">{userEmail}</p>
            </div>
          </div>
        </div>
      </header>

      <!-- Page content -->
      <div class="flex-1 overflow-y-auto pb-4">
        <slot />
      </div>
    </main>
  </body>
</html>
