---
const {
  title,
  description,
} = Astro.props as {
  title: string;
  description: string;
};
---

<div class="rounded-[1.5rem] border border-gray-100 bg-white p-8 text-center shadow-sm">
  <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full border border-gray-100 bg-gray-50 text-gray-400">
    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
  </div>
  <h3 class="text-lg font-semibold text-gray-900">{title}</h3>
  <p class="mx-auto mt-2 max-w-md text-sm text-gray-500">{description}</p>
  <div class="mt-5">
    <slot />
  </div>
</div>
