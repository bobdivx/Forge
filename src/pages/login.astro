---
import '../styles/global.css';
export const prerender = true;
---

<html lang="fr" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connexion | Ageton</title>
    <style>
      body { background: #F4F7F5; }
    </style>
  </head>
  <body class="min-h-full flex items-center justify-center p-4 font-sans antialiased" style="background:#F4F7F5">

    <div class="w-full max-w-[420px]">

      <!-- Logo -->
      <div class="flex flex-col items-center mb-8">
        <img src="/brand/logo-portrait.png" alt="La Forge d'Ageton" class="mb-4 max-h-44 w-auto object-contain" />
      </div>

      <!-- Card -->
      <div class="bg-white rounded-[1.5rem] shadow-sm p-8">

        <!-- Tabs -->
        <div class="flex border-b border-gray-200 mb-8" role="tablist">
          <button
            type="button"
            id="tab-login"
            role="tab"
            aria-selected="true"
            class="auth-tab flex-1 pb-3 text-center text-sm font-semibold border-b-2 transition-all"
            style="color:#175B37;border-color:#175B37"
          >
            Connexion
          </button>
          <button
            type="button"
            id="tab-register"
            role="tab"
            aria-selected="false"
            class="auth-tab flex-1 pb-3 text-center text-sm font-medium text-gray-400 border-b-2 border-transparent hover:text-gray-600 transition-all"
          >
            Créer un compte
          </button>
        </div>

        <form id="forge-auth-form" class="space-y-5">
          <div class="space-y-1.5">
            <label for="forge-email" class="block text-sm font-medium text-gray-700">Adresse e-mail</label>
            <input
              id="forge-email"
              name="email"
              type="email"
              autocomplete="username"
              required
              class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 placeholder-gray-400 outline-none transition-all focus:border-[#175B37] focus:bg-white focus:ring-2"
              style="--tw-ring-color:rgba(23,91,55,0.15)"
              placeholder="nom@domaine.com"
            />
          </div>
          <div class="space-y-1.5">
            <label for="forge-password" class="block text-sm font-medium text-gray-700">Mot de passe</label>
            <input
              id="forge-password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              minlength="10"
              class="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900 placeholder-gray-400 outline-none transition-all focus:border-[#175B37] focus:bg-white focus:ring-2"
              style="--tw-ring-color:rgba(23,91,55,0.15)"
              placeholder="Au moins 10 caractères"
            />
          </div>

          <p
            id="forge-auth-msg"
            class="hidden rounded-xl border border-red-200 bg-red-50 px-3 py-2.5 text-sm text-red-600"
            role="alert"
          ></p>

          <button
            type="submit"
            id="forge-submit"
            class="w-full rounded-xl py-3.5 text-sm font-semibold text-white transition-all hover:opacity-90 active:scale-[0.99] disabled:opacity-50 disabled:cursor-not-allowed"
            style="background:#175B37"
          >
            Se connecter
          </button>
        </form>

        <div id="forge-sso-wrap" class="hidden mt-6 space-y-3" aria-live="polite">
          <div class="flex items-center gap-3 text-xs text-gray-400">
            <span class="flex-1 h-px bg-gray-200"></span>
            <span>ou</span>
            <span class="flex-1 h-px bg-gray-200"></span>
          </div>
          <a
            href="/api/auth/oidc/login"
            class="flex w-full items-center justify-center rounded-xl border border-gray-200 bg-white py-3.5 text-sm font-semibold text-gray-800 transition-all hover:border-[#175B37] hover:bg-gray-50"
          >
            Continuer avec SSO (OpenID)
          </a>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-gray-400">
        Environnement privé — ne partagez jamais vos identifiants.
      </p>
    </div>

    <script is:inline>
      (function () {
        var mode = 'login';
        var form = document.getElementById('forge-auth-form');
        var msg = document.getElementById('forge-auth-msg');
        var submit = document.getElementById('forge-submit');
        var email = document.getElementById('forge-email');
        var password = document.getElementById('forge-password');
        var tabLogin = document.getElementById('tab-login');
        var tabRegister = document.getElementById('tab-register');
        var ssoWrap = document.getElementById('forge-sso-wrap');

        function showSsoIfEnabled() {
          fetch('/api/auth/oidc/status')
            .then(function (r) { return r.json(); })
            .then(function (d) {
              if (d && d.oidc && ssoWrap) ssoWrap.classList.remove('hidden');
            })
            .catch(function () {});
        }
        showSsoIfEnabled();

        function showSsoErrorFromQuery() {
          try {
            var params = new URLSearchParams(window.location.search);
            var sso = params.get('sso');
            if (!sso || !msg) return;
            var texts = {
              state:
                'Session SSO interrompue (cookies manquants ou délai dépassé). Réessayez la connexion SSO.',
              email:
                'Le fournisseur d’identité n’a pas renvoyé d’adresse e-mail. Vérifiez les scopes (openid, email) et le mapping côté IdP.',
              error: 'La connexion SSO a échoué. Vérifiez la configuration OIDC et les journaux serveur.',
              OIDC_EMAIL_DENIED:
                'Ce compte ou ce domaine e-mail n’est pas autorisé pour la connexion SSO.',
              USER_NOT_PROVISIONED:
                'Aucun utilisateur Forge pour cet e-mail : créez d’abord un compte ou ajustez FORGE_OIDC_REQUIRE_EXISTING_USER.',
              OIDC_INVALID_EMAIL: 'L’adresse e-mail renvoyée par le SSO est invalide.',
            };
            var text = texts[sso] || texts.error;
            msg.textContent = text;
            msg.classList.remove('hidden');
            if (window.history && window.history.replaceState) {
              window.history.replaceState(null, '', '/login');
            }
          } catch (e) {}
        }
        showSsoErrorFromQuery();

        function setMode(next) {
          mode = next;
          var isLogin = mode === 'login';
          tabLogin.setAttribute('aria-selected', isLogin ? 'true' : 'false');
          tabRegister.setAttribute('aria-selected', isLogin ? 'false' : 'true');
          if (isLogin) {
            tabLogin.style.color = '#175B37'; tabLogin.style.borderColor = '#175B37'; tabLogin.style.fontWeight = '600';
            tabRegister.style.color = '#9CA3AF'; tabRegister.style.borderColor = 'transparent'; tabRegister.style.fontWeight = '500';
          } else {
            tabRegister.style.color = '#175B37'; tabRegister.style.borderColor = '#175B37'; tabRegister.style.fontWeight = '600';
            tabLogin.style.color = '#9CA3AF'; tabLogin.style.borderColor = 'transparent'; tabLogin.style.fontWeight = '500';
          }
          submit.textContent = isLogin ? 'Se connecter' : 'Créer le compte';
          password.setAttribute('autocomplete', isLogin ? 'current-password' : 'new-password');
          email.setAttribute('autocomplete', isLogin ? 'username' : 'email');
          msg.classList.add('hidden');
          msg.textContent = '';
        }

        tabLogin.addEventListener('click', function () { setMode('login'); });
        tabRegister.addEventListener('click', function () { setMode('register'); });

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          msg.classList.add('hidden');
          var em = email.value.trim();
          var pw = password.value.trim();
          if (!em || !pw) return;
          submit.disabled = true;
          var endpoint = mode === 'register' ? '/api/auth/register' : '/api/auth/login';
          fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: em, password: pw }),
          })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
              if (res.ok) { window.location.href = '/dashboard'; return; }
              msg.textContent = res.data && res.data.error ? res.data.error : 'Identifiants incorrects ou erreur serveur.';
              msg.classList.remove('hidden');
            })
            .catch(function () { msg.textContent = 'Impossible de joindre le serveur.'; msg.classList.remove('hidden'); })
            .finally(function () { submit.disabled = false; });
        });
      })();
    </script>
  </body>
</html>
