# Copier vers .env et adapter (non commité — voir .gitignore).

# URL Forge joignable depuis les autres conteneurs / scripts (prioritaire sur cette valeur en prod).
# Alternative sans toucher Docker : renseigner « URL Forge joignable par les agents » dans Paramètres (table Config forgePublicUrl).
# FORGE_HOOK_BASE_URL=http://forge-host:4331

# Validation du chemin « Répertoire des applications » à la sauvegarde Paramètres (refuse si absent sur CE serveur).
# FORGE_SKIP_REPOS_ROOT_VALIDATION=1

# Désactive docker inspect/exec vers le conteneur ZimaOS (sonde volumes + test -d) sur /api/forge-repos-health.
# FORGE_DISABLE_ZIMAOS_PATH_PROBE=1

# Forge → Gateway ZimaOS (API). Même machine : 127.0.0.1 suffit.
# Forge en Docker, ZimaOS sur l’hôte : http://host.docker.internal:24190 avec `forge.yml`.
# En NAS/CasaOS, le port publie est souvent 24190 (-> 18789 interne ZimaOS).
ZIMAOS_GATEWAY_URL=http://host.docker.internal:24190

# Doit correspondre à gateway.auth.token dans AppData/zimaos/zimaos.json
ZIMAOS_GATEWAY_TOKEN=

# Webhook GitHub (PR Jules) : priorité à la table Config « githubWebhookSecret » (Paramètres → Jetons API).
# GITHUB_WEBHOOK_SECRET=   # secours si la DB est vide
# Logins GitHub additionnels traités comme Jules (séparés par des virgules)
# JULES_GITHUB_LOGINS=
# Forcer la session ZimaOS qui reçoit les missions PR Jules (ex. agent:main:main)
# JULES_ZIMAOS_SESSION_KEY=agent:main:main
