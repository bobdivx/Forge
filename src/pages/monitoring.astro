---
export const prerender = false;
import { App } from '../components/App';

const path = Astro.url.pathname + Astro.url.search;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Monitoring · DevForge</title>
    <meta name="description" content="Interface DevForge pour administrer serveurs, applications et bases." />
  </head>
  <body>
    <App client:load initialPath={path} />
  </body>
</html>
