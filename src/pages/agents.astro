---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import AgentsGrid from '../components/agents/AgentsGrid';
import SwarmInteractionsBoard from '../components/agents/SwarmInteractionsBoard';
import AgentTaskTable from '../components/agents/AgentTaskTable';
import AgentRepl from '../components/agents/AgentRepl';
import { loadAstroDb } from '../lib/load-astro-db';

let agentStats = { total: 0, withTasks: 0, totalTasks: 0, pendingIssues: 0 };
try {
  const { db, AgentTask, AgentInstruction, AgentAppIssue } = await loadAstroDb();
  const instructions = await db.select().from(AgentInstruction);
  const tasks = await db.select().from(AgentTask);
  const issues = await db.select().from(AgentAppIssue);
  agentStats.total = instructions.filter(i => i.enabled).length;
  agentStats.totalTasks = tasks.length;
  agentStats.pendingIssues = issues.filter(i => i.status === 'open' || i.status === 'pending').length;
  const agentsWithTasks = new Set(tasks.map(t => t.agentId));
  agentStats.withTasks = agentsWithTasks.size;
} catch { /* DB unavailable */ }
---

<DashboardLayout title="L'Équipe" currentPath="/agents">
  <div class="max-w-7xl mx-auto space-y-6">

    <!-- En-tête -->
    <div class="flex items-end justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-4xl font-bold mb-2 text-gray-900">L'Équipe</h1>
        <p class="text-gray-500 text-sm max-w-2xl">
          Les <strong>sessions OpenClaw</strong> apparaissent ici comme des membres d’équipe : nom, rôle, présence et
          tâches Forge. Les fiches personnalisées (avatar, bio) sont partagées avec la page{' '}
          <a href="/discussion" class="font-medium underline decoration-[#175B37]/30 hover:text-[#175B37]">Discussion</a>.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/agents/flux"
          class="flex items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
        >
          <svg class="h-4 w-4 text-[#175B37]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Flux Swarm
        </a>
        <a
          href="/discussion"
          class="flex items-center gap-2 rounded-full border border-[#175B37]/30 bg-[#E9F3EB] px-4 py-2 text-sm font-medium text-[#175B37] transition-colors hover:bg-[#dceee0]"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          Discussion OpenClaw
        </a>
        <a
          href="/agents/instructions"
          class="flex items-center gap-2 border border-gray-300 bg-white text-gray-700 text-sm font-medium px-4 py-2 rounded-full hover:bg-gray-50 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
          </svg>
          Instructions
        </a>
        <a
          href="/work"
          class="flex items-center gap-2 border border-gray-300 bg-white text-gray-700 text-sm font-medium px-4 py-2 rounded-full hover:bg-gray-50 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          Carnet de bord
        </a>
      </div>
    </div>

    <!-- KPIs équipe -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Agents actifs</span>
        <span class="text-5xl font-bold text-gray-900">{agentStats.total}</span>
        <span class="text-xs text-gray-400 block mt-2">membres de l'équipe</span>
      </div>
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">En mission</span>
        <span class="text-5xl font-bold" style="color:#3BAE61">{agentStats.withTasks}</span>
        <span class="text-xs text-gray-400 block mt-2">agents avec tâches</span>
      </div>
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Total tâches</span>
        <span class="text-5xl font-bold text-gray-900">{agentStats.totalTasks}</span>
        <span class="text-xs text-gray-400 block mt-2">en base Forge</span>
      </div>
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Bugs ouverts</span>
        <span class="text-5xl font-bold" style={`color:${agentStats.pendingIssues > 0 ? '#EAB308' : '#9CA3AF'}`}>{agentStats.pendingIssues}</span>
        <span class="text-xs text-gray-400 block mt-2">anomalies non résolues</span>
      </div>
    </div>

    <!-- Grille des membres -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <div class="w-1 h-6 rounded-full" style="background:#175B37"></div>
        <h3 class="text-base font-bold text-gray-900">Membres de l'équipe</h3>
        <span class="text-[10px] uppercase tracking-widest text-gray-400">Sessions OpenClaw · Auto-refresh 15s</span>
      </div>
      <AgentsGrid client:load />
    </section>

    <!-- Journal des tâches -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <div class="w-1 h-6 rounded-full" style="background:#3BAE61"></div>
        <h3 class="text-base font-bold text-gray-900">Journal des missions</h3>
        <span class="text-[10px] uppercase tracking-widest text-gray-400">Historique · Astro DB · Auto-refresh 10s</span>
        <a href="/work?tab=tasks" class="ml-auto text-xs hover:underline transition" style="color:#175B37">Voir tout →</a>
      </div>
      <div class="bg-white rounded-[1.5rem] shadow-sm overflow-hidden border border-gray-100">
        <AgentTaskTable client:load />
      </div>
    </section>

    <!-- Communications inter-agents -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <div class="w-1 h-6 rounded-full bg-blue-400"></div>
        <h3 class="text-base font-bold text-gray-900">Communications inter-agents</h3>
        <span class="text-[10px] uppercase tracking-widest text-gray-400">Messages AgentMessage · Astro DB</span>
      </div>
      <SwarmInteractionsBoard client:load />
    </section>

    <!-- Console REPL -->
    <section>
      <div class="flex items-center gap-3 mb-5">
        <div class="w-1 h-6 rounded-full" style="background:#3BAE61"></div>
        <h3 class="text-base font-bold text-gray-900">Console Forge</h3>
        <span class="text-[10px] uppercase tracking-widest text-gray-400">Commandes slash · Git · Docker · Mémoire</span>
        <span class="ml-auto text-[10px] font-mono text-gray-400">/help · /tools · /memory · /task</span>
      </div>
      <AgentRepl client:load />
    </section>

  </div>
</DashboardLayout>
