---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DiscussionComposer from '../components/discussion/DiscussionComposer';
---

<DashboardLayout title="Discussion" currentPath="/discussion">
  <div class="max-w-7xl mx-auto space-y-6">
    <div class="flex items-end justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-4xl font-bold mb-2 text-gray-900">Discussion</h1>
        <p class="text-gray-500 text-sm max-w-2xl">
          Composez un message avec le contexte d’un projet ou d’une demande du carnet, choisissez la session agent
          OpenClaw connectée, et testez la chaîne complète jusqu’au gateway — comme un banc d’essai pour l’équipe.
        </p>
      </div>
      <a
        href="/settings"
        class="text-xs border border-gray-200 bg-white rounded-full px-3 py-1.5 text-gray-600 hover:bg-gray-50"
      >
        Connexion OpenClaw
      </a>
    </div>

    <DiscussionComposer client:load />
  </div>
</DashboardLayout>
