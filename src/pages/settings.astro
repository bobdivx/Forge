---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import SettingsForm from '../components/settings/SettingsForm';
import OpenClawLayoutBadge from '../components/layout/OpenClawLayoutBadge';
import AgentModelMatrix from '../components/settings/AgentModelMatrix';
import { getReposRootResolved } from '../lib/forge-repos';

const reposRoot = await getReposRootResolved();
---
<DashboardLayout title="Paramètres" currentPath="/settings">
  <div class="max-w-4xl mx-auto space-y-6">

    <div class="flex items-end justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-4xl font-bold mb-2 text-gray-900">Paramètres</h1>
        <p class="text-gray-500 text-sm">Connexion OpenClaw, infrastructure, jetons API et configuration des agents.</p>
      </div>
      <a
        href="/agents/instructions"
        class="flex items-center gap-2 border border-gray-300 bg-white text-gray-700 text-sm font-medium px-4 py-2 rounded-full hover:bg-gray-50 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
        </svg>
        Instructions agents
      </a>
    </div>

    <SettingsForm client:load />

    <!-- Modèles agents -->
    <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 overflow-hidden">
      <div class="p-6 border-b border-gray-50">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Modèles agents</h3>
            <p class="text-[10px] text-gray-400">
              Attribution automatique des modèles Ollama par rôle agent. Vérifiez que chaque agent a son modèle enregistré dans le gateway OpenClaw.
            </p>
          </div>
          <a
            href="/agents/instructions"
            class="text-xs border border-gray-200 bg-white rounded-full px-3 py-1.5 text-gray-600 hover:bg-gray-50 transition-colors flex items-center gap-1.5 shrink-0"
          >
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
            </svg>
            Instructions
          </a>
        </div>
      </div>
      <div class="p-6">
        <AgentModelMatrix client:load />
      </div>
    </div>

    <!-- Infrastructure ZimaOS -->
    <div class="bg-white rounded-[1.5rem] shadow-sm overflow-hidden border border-gray-100">
      <div class="p-6">
        <h3 class="font-semibold text-gray-900 mb-1">Infrastructure ZimaOS <span class="text-xs text-gray-400 font-normal">(Lecture seule)</span></h3>
        <p class="text-[10px] text-gray-400 mb-6">Emplacements physiques des sources de vérité sur le disque NAS.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div>
            <label class="block text-[10px] font-bold text-gray-400 mb-1 uppercase tracking-wider">Dépôts GitHub</label>
            <div class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-xs text-gray-600 font-mono truncate">{reposRoot}</div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-gray-400 mb-1 uppercase tracking-wider">Docker YAML</label>
            <div class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-xs text-gray-600 font-mono truncate">/mnt/Docker/yaml</div>
          </div>
          <div>
            <label class="block text-[10px] font-bold text-gray-400 mb-1 uppercase tracking-wider">AppData ZimaOS</label>
            <div class="bg-gray-50 border border-gray-200 rounded-lg px-3 py-2 text-xs text-gray-600 font-mono truncate">/mnt/Docker/AppData</div>
          </div>
        </div>
      </div>
      
      <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">État de liaison</span>
          <OpenClawLayoutBadge client:load />
        </div>
      </div>
    </div>

  </div>
</DashboardLayout>
