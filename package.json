{
  "name": "forge-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-rollup-win32.cjs",
    "fix:rollup": "node scripts/ensure-rollup-win32.cjs",
    "reinstall": "node scripts/clean-install.mjs",
    "dev": "astro dev",
    "install:unc": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prep-npm-unc.ps1",
    "dev:unc": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prep-npm-unc.ps1 -RunDev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.60.1"
  },
  "dependencies": {
    "@astrojs/db": "^0.20.1",
    "@astrojs/node": "^10.0.4",
    "@astrojs/preact": "^5.1.1",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^10.0.4",
    "astro": "^6.1.5",
    "chart.js": "^4.5.1",
    "daisyui": "latest",
    "preact": "^10.29.0",
    "tailwindcss": "^3.4.19"
  }
}
