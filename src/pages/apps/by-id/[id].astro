---
// @ts-nocheck
export const prerender = false;

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import ProjectDemandesForm from '../../../components/apps/ProjectDemandesForm';
import AppProjectOps from '../../../components/apps/AppProjectOps';
import AuditLauncher from '../../../components/apps/AuditLauncher';
import path from 'path';
import { db, Project, Request, eq, desc } from 'astro:db';
import { resolveProjectPathFromDbProject, isSafeRepoDirName } from '../../../lib/forge-repos';
import { getGitCommits, getGitSummary } from '../../../lib/project-git';
import { mapDbRequestToUi } from '../../../lib/forge-request-mapper';

const rawId = Astro.params.id;
const projectId = parseInt(String(rawId), 10);
if (!Number.isInteger(projectId) || projectId < 1) {
  return Astro.redirect('/apps');
}

let row;
try {
  const rows = await db.select().from(Project);
  row = rows.find((r) => Number(r.id) === projectId);
} catch {
  return Astro.redirect('/apps');
}

if (!row) {
  return Astro.redirect('/apps');
}

const projectPath = await resolveProjectPathFromDbProject(row);
if (!projectPath) {
  return Astro.redirect('/apps');
}

const folderKey = path.basename(projectPath);
if (!isSafeRepoDirName(folderKey)) {
  return Astro.redirect('/apps');
}

const displayName = row.name || folderKey;

const { commits, error: gitLogError } = getGitCommits(projectPath, 30);
const gitSummary = getGitSummary(projectPath);

let requests = [];
try {
  const dbReq = await db
    .select()
    .from(Request)
    .where(eq(Request.projectId, row.id))
    .orderBy(desc(Request.updatedAt))
    .limit(100);
  requests = dbReq.map(mapDbRequestToUi);
} catch {
  /* Astro DB */
}

const changes = commits.map((c) => ({
  title: c.subject,
  detail: `${c.shortHash} — ${c.hash}`,
  date: c.date,
  by: c.author,
}));

const lastSync = commits[0]?.date || '—';
const app = {
  name: displayName,
  status: gitSummary.isRepo ? (gitSummary.dirty ? 'Modifications locales' : 'Dépôt Git') : 'Dépôt local',
  lastSync,
  url: `${folderKey.toLowerCase()}.forge.local`,
};
---

<DashboardLayout title={`Application: ${displayName}`} currentPath="/apps">
  <div class="max-w-7xl mx-auto space-y-6">

    <!-- Header projet -->
    <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 p-6">
      <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
          <a href="/apps" class="text-xs uppercase tracking-widest text-gray-400 hover:text-[#175B37] transition-colors">
            ← Retour aux projets
          </a>
          <h1 class="mt-2 text-2xl font-bold text-gray-900">{displayName}</h1>
          <p class="mt-1 text-[10px] font-mono text-gray-400">
            Projet #{row.id} ·{' '}
            <a href={`/apps/${encodeURIComponent(folderKey)}`} class="hover:underline" style="color:#175B37">
              /apps/{folderKey}
            </a>
          </p>
          {displayName !== folderKey && (
            <p class="mt-1 text-[10px] font-mono text-gray-400">Dépôt : {folderKey}</p>
          )}
          <p class="mt-1 text-[11px] font-mono text-gray-400 break-all">{projectPath}</p>
        </div>
        <div class="flex flex-col items-end gap-2">
          <span class="text-xs font-semibold px-3 py-1 rounded-full bg-green-50 text-green-600">{app.status}</span>
          {gitSummary.isRepo && (
            <div class="text-right text-[11px] font-mono space-y-0.5 text-gray-400">
              <div>
                branche <span class="text-blue-500">{gitSummary.branch || '—'}</span>
                {gitSummary.dirty && <span class="text-yellow-500 ml-2">● non commité</span>}
              </div>
              {gitSummary.aheadBehind && <div>{gitSummary.aheadBehind} vs upstream</div>}
              {gitSummary.error && <div class="text-yellow-500">{gitSummary.error}</div>}
            </div>
          )}
        </div>
      </div>
    </div>

    {gitLogError && (
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 text-sm text-yellow-700">
        Git : {gitLogError}
      </div>
    )}

    <AppProjectOps client:load appName={folderKey} forgeVirtualHost={app.url} />

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

      <!-- Historique Git -->
      <section class="xl:col-span-2 bg-white rounded-[1.5rem] shadow-sm border border-gray-100 p-6">
        <div class="flex items-center justify-between mb-5 flex-wrap gap-2">
          <h3 class="text-base font-semibold text-gray-900">Historique Git</h3>
          <a href={`http://${app.url}`} target="_blank" rel="noopener noreferrer"
            class="text-xs text-blue-500 hover:underline font-mono">
            http://{app.url}
          </a>
        </div>
        {changes.length > 0 ? (
          <div class="space-y-3">
            {changes.map((change) => (
              <article class="border border-gray-100 rounded-xl p-4 bg-gray-50 hover:bg-gray-100 transition-colors">
                <div class="flex items-start justify-between gap-4">
                  <h4 class="font-medium text-gray-900 break-words text-sm">{change.title}</h4>
                  <span class="text-xs text-gray-400 shrink-0">{change.date}</span>
                </div>
                <p class="text-gray-500 mt-1.5 font-mono text-[11px]">{change.detail}</p>
                <p class="text-xs text-gray-400 mt-2">
                  Auteur : <span class="font-mono" style="color:#175B37">{change.by}</span>
                </p>
              </article>
            ))}
          </div>
        ) : (
          <div class="border border-gray-100 rounded-xl p-4 bg-gray-50 text-sm text-gray-400">
            {gitSummary.isRepo
              ? 'Aucun commit lisible (dépôt vide ou erreur git log).'
              : "Initialisez un dépôt Git dans ce dossier pour afficher l'historique."}
          </div>
        )}
      </section>

      <!-- Colonne latérale -->
      <aside class="space-y-5">
        <AuditLauncher client:load projectName={displayName} projectPath={projectPath} />

        <ProjectDemandesForm client:load appName={folderKey} />

        <section class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 p-5">
          <h3 class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-4">File de demandes</h3>
          {requests.length > 0 ? (
            <div class="space-y-3">
              {requests.map((request) => (
                <article class="border border-gray-100 rounded-xl p-4 bg-gray-50">
                  <div class="flex items-center justify-between gap-3">
                    <p class="text-[10px] text-gray-400 font-mono">{request.id}</p>
                    <span
                      class={`text-[10px] uppercase font-semibold px-2 py-1 rounded ${
                        request.status === 'Traite'
                          ? 'bg-green-50 text-green-600'
                          : request.status === 'En cours'
                            ? 'bg-blue-50 text-blue-600'
                            : request.status === 'Rejetée'
                              ? 'bg-red-50 text-red-500'
                              : 'bg-yellow-50 text-yellow-600'
                      }`}
                    >
                      {request.status}
                    </span>
                  </div>
                  <p class="mt-2 text-sm text-gray-800 font-medium">{request.title}</p>
                  {request.detail && <p class="mt-1.5 text-xs text-gray-400">{request.detail}</p>}
                  <p class="mt-2 text-xs text-gray-400">
                    Type : <span class="text-gray-600">{request.type}</span>
                  </p>
                  <p class="text-xs text-gray-400">
                    Agent : <span class="font-mono" style="color:#175B37">{request.agent}</span>
                  </p>
                  <p class="text-xs text-gray-400 mt-2">
                    {new Date(request.updatedAt).toLocaleString('fr-FR')}
                  </p>
                </article>
              ))}
            </div>
          ) : (
            <div class="border border-gray-100 rounded-xl p-4 bg-gray-50 text-sm text-gray-400">
              Aucune demande enregistrée. Utilisez le formulaire ci-dessus.
            </div>
          )}
        </section>
      </aside>

    </div>
  </div>
</DashboardLayout>
