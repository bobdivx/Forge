---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DiscussionComposer from '../components/discussion/DiscussionComposer';
---

<DashboardLayout title="Discussion" currentPath="/discussion">
  <div class="mx-auto max-w-6xl animate-fade-in px-1 pb-10 sm:px-0 md:pb-14">
    <!-- Intro : espacement vertical net par rapport au fil de discussion -->
    <section
      class="relative mb-10 overflow-hidden rounded-[1.75rem] border border-gray-200/80 bg-white shadow-md shadow-gray-200/30 ring-1 ring-black/[0.04] md:mb-14"
    >
      <div
        class="pointer-events-none absolute -right-20 -top-28 h-64 w-64 rounded-full bg-[#3BAE61]/12 blur-3xl motion-safe:animate-pulse"
        aria-hidden="true"
      />
      <div
        class="pointer-events-none absolute -bottom-24 -left-16 h-56 w-56 rounded-full bg-[#175B37]/10 blur-3xl"
        aria-hidden="true"
      />

      <div class="relative grid gap-10 p-8 sm:p-10 lg:grid-cols-[minmax(0,1fr)_min(100%,260px)] lg:items-start lg:gap-14">
        <div class="flex flex-col gap-6">
          <div class="space-y-4">
            <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-[#175B37]/90">OpenClaw · Forge</p>
            <h1 class="text-3xl font-bold leading-tight tracking-tight text-gray-900 sm:text-4xl">Discussion</h1>
            <p class="max-w-xl text-[15px] leading-relaxed text-gray-600 sm:text-base">
              Échangez avec une <strong>session OpenClaw</strong> connectée au gateway. Enrichissez le fil avec un
              projet ou une demande du carnet pour cadrer le contexte côté Forge.
            </p>
          </div>

          <ul class="grid gap-3 sm:grid-cols-3 sm:gap-4">
            <li class="rounded-2xl border border-gray-100 bg-gray-50/80 px-4 py-3.5 text-sm leading-snug text-gray-600 shadow-inner shadow-white/60">
              <span class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-gray-400">Contexte</span>
              Projet ou demande optionnels
            </li>
            <li class="rounded-2xl border border-gray-100 bg-gray-50/80 px-4 py-3.5 text-sm leading-snug text-gray-600 shadow-inner shadow-white/60">
              <span class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-gray-400">Réponses</span>
              Stream / poll selon le gateway
            </li>
            <li class="rounded-2xl border border-gray-100 bg-gray-50/80 px-4 py-3.5 text-sm leading-snug text-gray-600 shadow-inner shadow-white/60 sm:col-span-1">
              <span class="mb-1 block text-[10px] font-bold uppercase tracking-wider text-gray-400">Interface</span>
              Colonne équipe + fil, mobile inclus
            </li>
          </ul>
        </div>

        <aside class="flex flex-col gap-3 rounded-2xl border border-gray-100 bg-gray-50/50 p-5 lg:sticky lg:top-4">
          <p class="text-xs leading-relaxed text-gray-500">
            Token, URL du gateway et diagnostics : tout se pilote depuis les paramètres Forge.
          </p>
          <a
            href="/settings"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-[#175B37]/25 bg-[#175B37] px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#134a2d] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#175B37]/50"
          >
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Connexion OpenClaw
          </a>
          <a
            href="/agents"
            class="text-center text-xs font-medium text-[#175B37] underline-offset-2 transition hover:underline"
          >
            Voir toutes les sessions sur « L’équipe »
          </a>
        </aside>
      </div>
    </section>

    <!-- Séparateur visuel avant le bloc messagerie -->
    <div class="mb-8 h-px w-full bg-gradient-to-r from-transparent via-gray-200 to-transparent md:mb-10" aria-hidden="true" />

    <section class="rounded-[1.75rem] border border-gray-200/90 bg-[#ECEFF1]/40 p-1 shadow-sm ring-1 ring-black/[0.03] sm:p-2">
      <DiscussionComposer client:load />
    </section>
  </div>
</DashboardLayout>
