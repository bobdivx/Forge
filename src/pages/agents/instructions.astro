---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AgentInstructionEditor from '../../components/agents/AgentInstructionEditor';
---

<DashboardLayout title="Instructions Agents" currentPath="/agents/instructions">
  <div class="max-w-7xl mx-auto space-y-6">

    <!-- En-tête -->
    <div class="flex items-end justify-between flex-wrap gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2 text-sm">
          <a href="/settings" class="text-gray-400 hover:text-gray-600 transition-colors">Paramètres</a>
          <span class="text-gray-300">/</span>
          <a href="/agents" class="text-gray-400 hover:text-gray-600 transition-colors">L'Équipe</a>
          <span class="text-gray-300">/</span>
          <span class="text-gray-700 font-medium">Instructions</span>
        </div>
        <h1 class="text-4xl font-bold mb-2 text-gray-900">Instructions Agents</h1>
        <p class="text-gray-500 text-sm max-w-2xl">
          Gérez les system prompts de chaque agent directement depuis le dashboard.
          La DB est la source de vérité — le bouton <strong class="text-gray-700">⚡ Sync</strong> régénère les fichiers
          <code class="text-[#175B37] text-xs font-mono">.md</code> lus par ZimaOS.
        </p>
      </div>
      <a
        href="/agents"
        class="flex items-center gap-2 border border-gray-300 bg-white text-gray-700 text-sm font-medium px-4 py-2 rounded-full hover:bg-gray-50 transition-colors"
      >
        ← L'Équipe
      </a>
    </div>

    <!-- OpenSpec — même dépôt, flux specs / changes -->
    <details
      id="openspec-panel"
      class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 overflow-hidden"
      open
    >
      <summary
        class="cursor-pointer px-6 py-4 font-semibold text-gray-900 border-b border-gray-100 select-none"
      >
        <span class="inline-flex items-center gap-2">
          <span class="text-[#175B37]">◇</span>
          OpenSpec — spécifications dans le dépôt
        </span>
      </summary>
      <div class="px-6 py-4 text-sm text-gray-600 space-y-4">
        <p>
          Forge suit
          <a href="https://openspec.dev" class="text-[#175B37] underline hover:no-underline" target="_blank" rel="noopener noreferrer"
            >OpenSpec</a
          >
          : alignement sur l’intent avant le code, specs versionnées avec le projet.
        </p>
        <ul class="list-disc list-inside space-y-1 text-gray-700">
          <li>
            Specs courantes :
            <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded break-all">openspec/specs/</code>
          </li>
          <li>
            Propositions en cours :
            <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded break-all">openspec/changes/&lt;id&gt;/</code>
            (proposal, design, tasks, deltas)
          </li>
        </ul>
        <p class="text-gray-700">
          Dans <strong class="font-medium">Cursor</strong>, après redémarrage de l’IDE si besoin :
          <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded whitespace-nowrap">/opsx:propose</code>,
          <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded whitespace-nowrap">/opsx:explore</code>,
          <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded whitespace-nowrap">/opsx:apply</code>,
          <code class="text-xs bg-gray-100 px-1.5 py-0.5 rounded whitespace-nowrap">/opsx:archive</code>.
        </p>
        <p class="text-xs text-gray-500">
          Le contexte projet pour les artefacts est dans
          <code class="bg-gray-100 px-1 rounded break-all">openspec/config.yaml</code>.
        </p>
      </div>
    </details>

    <!-- Éditeur -->
    <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 p-6">
      <AgentInstructionEditor client:load />
    </div>

  </div>
</DashboardLayout>
