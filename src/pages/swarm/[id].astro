---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AgentSteerForm from '../../components/agents/AgentSteerForm';
import AgentDirectiveForm from '../../components/agents/AgentDirectiveForm';
import AgentMissionJournal from '../../components/agents/AgentMissionJournal';
import AgentSwarmCommandCenter from '../../components/agents/AgentSwarmCommandCenter';
import { loadAstroDb } from '../../lib/load-astro-db';
import {
  fetchOpenClawSessionsPayload,
  normalizeOpenClawSessions,
  mapSessionToAgentRow,
} from '../../lib/openclaw-gateway';
import { findRawSessionForSwarmAgentKey } from '../../lib/swarm-agent-resolve';

const { id } = Astro.params;
const email = Astro.locals.user?.email;
const agentKey = id || '';

let agentInfo = null;
try {
  const result = await fetchOpenClawSessionsPayload(email);
  if (result.ok) {
    const sessions = normalizeOpenClawSessions(result.data) as Record<string, unknown>[];
    const sessionObj = findRawSessionForSwarmAgentKey(sessions, agentKey);
    if (sessionObj) agentInfo = mapSessionToAgentRow(sessionObj);
  }
} catch { /* session info indisponible */ }

/** Clé `sessions_send` (ex. telegram:…) — pas seulement le segment d’URL. */
const openClawSessionKey = agentInfo?.id || agentKey;

let tasks = [];
let appIssues = [];
let depRequests = [];
try {
  const { db, AgentTask, AgentAppIssue, AgentDependencyRequest, eq, desc } = await loadAstroDb();
  tasks = await db.select().from(AgentTask).where(eq(AgentTask.agentId, agentKey)).orderBy(desc(AgentTask.createdAt));
  const allIssues = await db.select().from(AgentAppIssue).orderBy(desc(AgentAppIssue.createdAt)).limit(120);
  appIssues = allIssues.filter((r) => r.reportedByAgentId === agentKey || r.assigneeAgentId === agentKey);
  const allDeps = await db.select().from(AgentDependencyRequest).orderBy(desc(AgentDependencyRequest.createdAt)).limit(120);
  depRequests = allDeps.filter((r) => r.requestedByAgentId === agentKey || r.assigneeAgentId === agentKey);
} catch { /* tables absentes ou DB indisponible */ }

const missionTasksJson = tasks.map((t) => ({
  id: t.id,
  agentId: t.agentId,
  task: t.task,
  input: t.input ?? null,
  output: t.output ?? null,
  status: t.status,
  createdAt: t.createdAt instanceof Date ? t.createdAt.toISOString() : String(t.createdAt),
  updatedAt: t.updatedAt instanceof Date ? t.updatedAt.toISOString() : String(t.updatedAt),
}));

const displayName = agentInfo
  ? agentInfo.name.replace('telegram:g-agent-', '').replace('agent:', '').toUpperCase()
  : id;

function statusBadge(status: string) {
  const s = String(status ?? '').toLowerCase();
  if (s === 'success' || s === 'resolved' || s === 'installed') return 'bg-green-50 text-green-600';
  if (s === 'running' || s === 'in_progress') return 'bg-blue-50 text-blue-600';
  if (s === 'error' || s === 'rejected') return 'bg-red-50 text-red-500';
  return 'bg-yellow-50 text-yellow-600';
}
---

<DashboardLayout title={`Agent ${displayName}`} currentPath="/agents">
  <div class="max-w-7xl mx-auto space-y-6">

    <!-- Header -->
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div class="flex items-center gap-4">
        <a
          href="/agents"
          class="flex items-center gap-2 border border-gray-300 bg-white text-gray-700 text-sm font-medium px-4 py-2 rounded-full hover:bg-gray-50 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          L'Équipe
        </a>
        <h1 class="text-2xl font-bold text-gray-900 tracking-tight flex items-center gap-3">
          {displayName}
          {agentInfo && (
            <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${agentInfo.status === 'actif' ? 'bg-green-50 text-green-600' : 'bg-gray-100 text-gray-500'}`}>
              {agentInfo.status}
            </span>
          )}
        </h1>
      </div>
      <div class="text-[10px] font-mono text-gray-400 bg-white px-3 py-1.5 rounded-full border border-gray-200">
        ID: {id}
      </div>
    </div>

    <AgentSwarmCommandCenter client:load agentId={agentKey} sessionKey={openClawSessionKey} />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-5">

        <!-- Stats rapides -->
        {agentInfo && (
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 p-4">
              <span class="text-[10px] font-bold text-gray-400 uppercase block mb-1">Modèle</span>
              <span class="text-sm font-mono text-blue-500 truncate block">{(agentInfo.model || '—').toString().split('/').pop()}</span>
            </div>
            <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 p-4">
              <span class="text-[10px] font-bold text-gray-400 uppercase block mb-1">Tokens</span>
              <span class="text-sm font-mono text-gray-900">{(agentInfo.totalTokens || 0).toLocaleString()}</span>
            </div>
            <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 p-4">
              <span class="text-[10px] font-bold text-gray-400 uppercase block mb-1">Coût estimé</span>
              <span class="text-sm font-mono" style="color:#3BAE61">${agentInfo.estimatedCostUsd.toFixed(2)}</span>
            </div>
            <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 p-4">
              <span class="text-[10px] font-bold text-gray-400 uppercase block mb-1">Maj</span>
              <span class="text-sm font-mono text-gray-500">{agentInfo.lastSeen.split(' ').pop()}</span>
            </div>
          </div>
        )}

        <!-- Journal de Mission -->
        <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            <h3 class="font-semibold text-gray-900 text-sm">Journal de Mission (Astro DB)</h3>
          </div>
          <AgentMissionJournal client:load initialTasks={missionTasksJson} sessionKey={openClawSessionKey} syncAgentId={agentKey} />
        </div>

        <!-- Anomalies -->
        <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-900 text-sm">Anomalies pages</h3>
            <p class="text-[10px] text-gray-400 mt-0.5">Publiées via forge-hook <code class="text-gray-500 font-mono">app_issue</code> ou <code class="text-gray-500 font-mono">POST /api/agent-issues</code>.</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gray-100">
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Statut</th>
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Type / URL</th>
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Titre</th>
                </tr>
              </thead>
              <tbody>
                {appIssues.length === 0 ? (
                  <tr>
                    <td colspan="3" class="text-center py-8 text-gray-400 italic text-sm">Aucune anomalie pour {agentKey}.</td>
                  </tr>
                ) : (
                  appIssues.map((i) => (
                    <tr key={i.id} class="border-b border-gray-50 hover:bg-gray-50 transition-colors">
                      <td class="px-5 py-3">
                        <span class={`text-[10px] font-semibold px-2 py-1 rounded ${statusBadge(i.status)}`}>{i.status}</span>
                      </td>
                      <td class="px-5 py-3 font-mono text-[10px] text-gray-400 max-w-[200px] truncate">{i.errorType} · {i.url}</td>
                      <td class="px-5 py-3 text-xs text-gray-800 max-w-xs truncate">{i.title}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Dépendances -->
        <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-900 text-sm">Demandes de dépendances</h3>
            <p class="text-[10px] text-gray-400 mt-0.5"><code class="text-gray-500 font-mono">dependency_request</code> ou <code class="text-gray-500 font-mono">POST /api/agent-dependencies</code>.</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gray-100">
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Statut</th>
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Paquet</th>
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Raison</th>
                </tr>
              </thead>
              <tbody>
                {depRequests.length === 0 ? (
                  <tr>
                    <td colspan="3" class="text-center py-8 text-gray-400 italic text-sm">Aucune demande pour {agentKey}.</td>
                  </tr>
                ) : (
                  depRequests.map((d) => (
                    <tr key={d.id} class="border-b border-gray-50 hover:bg-gray-50 transition-colors">
                      <td class="px-5 py-3">
                        <span class={`text-[10px] font-semibold px-2 py-1 rounded ${statusBadge(d.status)}`}>{d.status}</span>
                      </td>
                      <td class="px-5 py-3 font-mono text-xs text-blue-500">{d.packageName}{d.versionSpec ? `@${d.versionSpec}` : ''}{d.isDev ? ' (dev)' : ''}</td>
                      <td class="px-5 py-3 text-xs text-gray-400 max-w-xs truncate">{d.reason ?? '—'}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Colonne pilotage -->
      <div class="space-y-5">
        {agentInfo && agentInfo.raw?.model != null && (
          <AgentSteerForm client:load sessionKey={openClawSessionKey} currentModel={agentInfo.raw.model} />
        )}
        {agentInfo && (
          <AgentDirectiveForm client:load sessionKey={openClawSessionKey} />
        )}
      </div>
    </div>

  </div>
</DashboardLayout>
