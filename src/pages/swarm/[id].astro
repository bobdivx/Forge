---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AgentSteerForm from '../../components/agents/AgentSteerForm';
import AgentSwarmModelPicker from '../../components/agents/AgentSwarmModelPicker';
import AgentDirectiveForm from '../../components/agents/AgentDirectiveForm';
import AgentMissionJournal from '../../components/agents/AgentMissionJournal';
import AgentSwarmCommandCenter from '../../components/agents/AgentSwarmCommandCenter';
import AgentSwarmEmployeeProfile from '../../components/agents/AgentSwarmEmployeeProfile';
import AgentToolsPanel from '../../components/agents/AgentToolsPanel';
import { loadAstroDb } from '../../lib/load-astro-db';
import { buildAgentTeamProfile } from '../../lib/agent-profile';
import {
  listForgeProjectScopedChildAgents,
  parseForgeParentAgentId,
} from '../../lib/forge-project-scoped-agents';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;
const agentKey = id || '';

let instructionRow = null;
let tasks = [];
let appIssues = [];
let depRequests = [];
try {
  const { db, AgentTask, AgentAppIssue, AgentDependencyRequest, AgentInstruction, eq, desc } = await loadAstroDb();
  const [instRows, tasksRows, allIssues, allDeps] = await Promise.all([
    db.select().from(AgentInstruction).where(eq(AgentInstruction.agentId, agentKey)).limit(1),
    db.select().from(AgentTask).where(eq(AgentTask.agentId, agentKey)).orderBy(desc(AgentTask.createdAt)),
    db.select().from(AgentAppIssue).orderBy(desc(AgentAppIssue.createdAt)).limit(120),
    db.select().from(AgentDependencyRequest).orderBy(desc(AgentDependencyRequest.createdAt)).limit(120)
  ]);
  instructionRow = instRows[0] ?? null;
  tasks = tasksRows;
  appIssues = allIssues.filter((r) => r.reportedByAgentId === agentKey || r.assigneeAgentId === agentKey);
  depRequests = allDeps.filter((r) => r.requestedByAgentId === agentKey || r.assigneeAgentId === agentKey);
} catch { /* tables absentes ou DB indisponible */ }

const missionTasksJson = tasks.map((t) => ({
  id: t.id,
  agentId: t.agentId,
  task: t.task,
  input: t.input ?? null,
  output: t.output ?? null,
  status: t.status,
  createdAt: t.createdAt instanceof Date ? t.createdAt.toISOString() : String(t.createdAt),
  updatedAt: t.updatedAt instanceof Date ? t.updatedAt.toISOString() : String(t.updatedAt),
}));

const displayName = id;

const parentAgentId = parseForgeParentAgentId(agentKey);

const modelFromInstruction = instructionRow ? String(instructionRow.model || '').trim() : '';
/** Modèle par défaut affiché / éditable côté Forge (base). */
const forgeDefaultModel = modelFromInstruction;
const statusFromInstruction = instructionRow
  ? Number(instructionRow.enabled) === 1
    ? 'actif'
    : 'désactivé en base'
  : null;

const agentLike = {
  id: agentKey,
  name: displayName || agentKey,
  status: statusFromInstruction || 'non enregistré en base',
  model: modelFromInstruction || '—',
};
const teamProfile = buildAgentTeamProfile(agentLike);

let subagentsList: { agentId: string; model: string; enabled: number; projectLabel: string }[] = [];
try {
  subagentsList = await listForgeProjectScopedChildAgents(agentKey);
} catch {
  subagentsList = [];
}

function formatInstructionUpdatedAt(v) {
  if (!v) return '—';
  try {
    const d = v instanceof Date ? v : new Date(String(v));
    if (Number.isNaN(d.getTime())) return '—';
    return d.toLocaleString('fr-FR');
  } catch {
    return '—';
  }
}

let agentRuntimeJson = {
  status: '—',
  model: '—',
  totalTokens: 0,
  estimatedCostUsd: 0,
  lastSeen: '—',
};

if (instructionRow) {
  const en = Number(instructionRow.enabled) === 1;
  agentRuntimeJson = {
    status: en ? 'actif (Forge)' : 'désactivé (Forge)',
    model: String(instructionRow.model || '—'),
    totalTokens: 0,
    estimatedCostUsd: 0,
    lastSeen: formatInstructionUpdatedAt(instructionRow.updatedAt),
  };
} else {
  agentRuntimeJson = {
    status: 'non enregistré',
    model: '—',
    totalTokens: 0,
    estimatedCostUsd: 0,
    lastSeen: '—',
  };
}

function statusBadge(status: string) {
  const s = String(status ?? '').toLowerCase();
  if (s === 'success' || s === 'resolved' || s === 'installed') return 'bg-green-50 text-green-600';
  if (s === 'running' || s === 'in_progress') return 'bg-blue-50 text-blue-600';
  if (s === 'error' || s === 'rejected') return 'bg-red-50 text-red-500';
  return 'bg-yellow-50 text-yellow-600';
}
---

<DashboardLayout title={`${teamProfile.displayName} · Forge`} currentPath="/agents">
  <div class="max-w-7xl mx-auto space-y-8">

    <div class="flex flex-wrap items-center justify-between gap-3">
      <a
        href="/agents"
        class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-gray-50"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Retour à l’équipe
      </a>
    </div>

    <AgentSwarmEmployeeProfile
      client:load
      teamProfile={teamProfile}
      displayCode={id || agentKey}
      agentRuntime={agentRuntimeJson}
      hasForgeInstruction={Boolean(instructionRow)}
      subagents={subagentsList}
      parentAgentId={parentAgentId}
    />

    <AgentSwarmModelPicker
      client:load
      agentId={agentKey}
      initialModel={forgeDefaultModel}
      cascadeToSubagents={!parentAgentId}
      subagentCount={subagentsList.length}
    />

    <AgentSwarmCommandCenter client:load agentId={agentKey} />

    <AgentToolsPanel client:load agentId={agentKey} />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 space-y-5">

        <!-- Journal de Mission -->
        <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100 flex flex-col gap-0.5 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
              </svg>
              <div>
                <h3 class="font-semibold text-gray-900 text-sm">Missions & livrables</h3>
                <p class="text-[10px] text-gray-400">Journal Astro DB — même source que l’orchestrateur.</p>
              </div>
            </div>
          </div>
          <AgentMissionJournal client:load initialTasks={missionTasksJson} syncAgentId={agentKey} />
        </div>

        <!-- Anomalies -->
        <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-900 text-sm">Qualité & anomalies (apps)</h3>
            <p class="text-[10px] text-gray-400 mt-0.5">Signalements rattachés à cet agent — via forge-hook ou API.</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gray-100">
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Statut</th>
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Type / URL</th>
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Titre</th>
                </tr>
              </thead>
              <tbody>
                {appIssues.length === 0 ? (
                  <tr>
                    <td colspan="3" class="text-center py-8 text-gray-400 italic text-sm">Aucune anomalie pour {agentKey}.</td>
                  </tr>
                ) : (
                  appIssues.map((i) => (
                    <tr key={i.id} class="border-b border-gray-50 hover:bg-gray-50 transition-colors">
                      <td class="px-5 py-3">
                        <span class={`text-[10px] font-semibold px-2 py-1 rounded ${statusBadge(i.status)}`}>{i.status}</span>
                      </td>
                      <td class="px-5 py-3 font-mono text-[10px] text-gray-400 max-w-[200px] truncate">{i.errorType} · {i.url}</td>
                      <td class="px-5 py-3 text-xs text-gray-800 max-w-xs truncate">{i.title}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Dépendances -->
        <div class="bg-white rounded-[1.5rem] shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100">
            <h3 class="font-semibold text-gray-900 text-sm">Demandes de dépendances</h3>
            <p class="text-[10px] text-gray-400 mt-0.5">Paquets et bibliothèques proposés ou attendus pour les dépôts suivis.</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-gray-100">
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Statut</th>
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Paquet</th>
                  <th class="text-[10px] uppercase font-bold text-gray-400 px-5 py-3 text-left">Raison</th>
                </tr>
              </thead>
              <tbody>
                {depRequests.length === 0 ? (
                  <tr>
                    <td colspan="3" class="text-center py-8 text-gray-400 italic text-sm">Aucune demande pour {agentKey}.</td>
                  </tr>
                ) : (
                  depRequests.map((d) => (
                    <tr key={d.id} class="border-b border-gray-50 hover:bg-gray-50 transition-colors">
                      <td class="px-5 py-3">
                        <span class={`text-[10px] font-semibold px-2 py-1 rounded ${statusBadge(d.status)}`}>{d.status}</span>
                      </td>
                      <td class="px-5 py-3 font-mono text-xs text-blue-500">{d.packageName}{d.versionSpec ? `@${d.versionSpec}` : ''}{d.isDev ? ' (dev)' : ''}</td>
                      <td class="px-5 py-3 text-xs text-gray-400 max-w-xs truncate">{d.reason ?? '—'}</td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Colonne pilotage -->
      <div class="space-y-5">
        {instructionRow && (
          <AgentSteerForm
            client:load
            agentId={agentKey}
            currentModel={String(instructionRow?.model ?? '')}
          />
        )}
        {instructionRow && <AgentDirectiveForm client:load agentId={agentKey} />}
      </div>
    </div>

  </div>
</DashboardLayout>
