---
// @ts-nocheck
import '../styles/global.css';
import MobileMenu from "../components/layout/MobileMenu";
import NotificationBellIcon from "../components/icons/NotificationBellIcon";
import { isNavItemActive, navGroups } from "../lib/navigation";
const { title, currentPath = Astro.url.pathname } = Astro.props;
const userEmail = String(Astro.locals?.user?.email ?? 'utilisateur');
const userInitial = userEmail.charAt(0).toUpperCase();
const userName = userEmail.split('@')[0];
---

<html lang="fr" class="h-full" data-theme="forge">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Ageton</title>
    <style>
      body { background-color: #F4F7F5; }
    </style>
  </head>
  <body class="flex gap-4 p-3 md:p-4 lg:gap-5 min-h-screen font-sans text-gray-800 antialiased" style="background:#F4F7F5">

    <!-- ── Sidebar ──────────────────────────────────────────────────── -->
    <aside class="hidden md:flex w-64 shrink-0 bg-white rounded-[2rem] p-6 flex-col justify-between shadow-sm" style="min-height: calc(100vh - 2rem)">
      <div>
        <!-- Logo -->
        <div class="flex items-center gap-3 mb-10">
          <img
            src="/brand/logo.png"
            alt="Logo Ageton"
            class="h-9 w-9 rounded-full object-contain cursor-pointer"
            onclick="window.location.href='/'"
          />
          <span class="text-xl font-bold text-gray-900">Ageton</span>
        </div>


        {navGroups.map((group) => (
          <div class="mb-8">
            <p class="mb-4 text-xs font-semibold tracking-wider text-gray-400">{group.label.toUpperCase()}</p>
            <nav class="flex flex-col gap-1">
              {group.items.map((item) => {
                const isActive = isNavItemActive(currentPath, item);
                return (
                  <a
                    href={item.path}
                    class={`flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-colors ${
                      isActive ? 'bg-[#E9F3EB] font-semibold text-[#175B37]' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-700'
                    }`}
                  >
                    <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.iconPath} />
                    </svg>
                    {item.name}
                  </a>
                );
              })}
            </nav>
          </div>
        ))}
      </div>
    </aside>

    <!-- ── Main ──────────────────────────────────────────────────────── -->
    <main class="flex-1 flex min-h-[calc(100dvh-1.5rem)] min-w-0 flex-col gap-4 md:gap-5">

      <!-- Top header -->
      <header class="bg-white rounded-2xl px-4 md:px-5 py-3 shadow-sm flex items-center justify-between gap-3 shrink-0">
        <!-- Left: mobile menu + search -->
        <div class="flex items-center gap-3 flex-1 min-w-0">
          <MobileMenu client:load currentPath={currentPath} />
          <div class="hidden sm:flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-full px-4 py-2 flex-1 max-w-xs">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input
              type="text"
              placeholder="Rechercher…"
              class="bg-transparent border-none focus:outline-none text-sm w-full text-gray-600 placeholder-gray-400"
            />
            <kbd class="shrink-0 text-[10px] bg-gray-200 text-gray-500 px-1.5 py-0.5 rounded">⌘F</kbd>
          </div>
          <div class="sm:hidden flex items-center gap-2 overflow-x-auto">
            {navGroups[1].items.slice(0, 2).map((item) => (
              <a
                href={item.path}
                class={`whitespace-nowrap rounded-full border px-3 py-2 text-xs font-medium ${
                  isNavItemActive(currentPath, item) ? 'border-[#175B37]/30 bg-[#E9F3EB] text-[#175B37]' : 'border-gray-200 bg-white text-gray-600'
                }`}
              >
                {item.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Right: icons + user -->
        <div class="flex items-center gap-2 shrink-0">
          <button class="h-11 w-11 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition-colors">
            <svg class="w-4.5 h-4.5 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </button>
          <button class="h-11 w-11 rounded-full border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition-colors">
            <NotificationBellIcon class="w-5 h-5" />
          </button>
          <!-- Avatar + nom -->
          <div class="flex items-center gap-2.5 pl-1">
            <div class="h-11 w-11 rounded-full flex items-center justify-center font-bold text-sm text-white shrink-0" style="background:#175B37">
              {userInitial}
            </div>
            <div class="hidden lg:block text-sm leading-tight">
              <p class="font-semibold text-gray-800">{userName}</p>
              <p class="text-gray-400 text-xs">{userEmail}</p>
            </div>
          </div>
        </div>
      </header>

      <!-- Page content -->
      <div class="flex-1 min-h-0 overflow-y-auto pb-4">
        <slot />
      </div>
    </main>
    <script src="/agent-pet-widget.iife.js?v=11" data-auto-mount="false"></script>
    <script is:inline>
      function initPet() {
        if (!window.AgentPet) return;
        
        let config = null;
        try {
          const rawConfig = localStorage.getItem("agent-pet:config");
          if (rawConfig) {
            config = JSON.parse(rawConfig);
          }
        } catch (e) {}

        // Si l'animal est désactivé dans la config, on ne le monte pas
        if (config && config.enabled === false) {
          return;
        }

        const isMobile = window.innerWidth < 768;
        
        // Floating mode for all devices
        window.AgentPet.mount({
          chat: true,
          name: config?.custom?.name,
          accent: config?.custom?.accent,
        });
        
        window.AgentPet.play("greeting");

        // Interactive responses
        window.AgentPet.on('userMessage', (msg) => {
          const m = msg.toLowerCase();
          if (m.includes('salut') || m.includes('bonjour') || m.includes('hello')) {
            window.AgentPet.play('greeting');
            window.AgentPet.say("Salut ! Comment ça va aujourd'hui ?");
          } else if (m.includes('aide') || m.includes('help')) {
            window.AgentPet.play('thinking');
            window.AgentPet.say("Je suis là pour t'accompagner. Tu peux configurer tes agents dans les paramètres !");
          } else {
            window.AgentPet.play('excited');
            window.AgentPet.say("Je t'écoute !");
          }
        });

        // Agent Connection Logic
        let lastTaskId = null;
        setInterval(() => {
          try {
            const rawConfig = localStorage.getItem("agent-pet:config");
            if (!rawConfig) return;
            const config = JSON.parse(rawConfig);
            const assignedAgent = config?.custom?.assignedAgent;
            
            if (!assignedAgent) return;

            fetch('/api/agents')
              .then(r => r.json())
              .then(data => {
                if (!data.agents) return;
                const agent = data.agents.find(a => a.id === assignedAgent);
                if (!agent) return;

                const currentWork = agent.currentWork;
                
                if (currentWork && currentWork.taskId !== lastTaskId) {
                  // Nouvelle tâche détectée !
                  lastTaskId = currentWork.taskId;
                  window.AgentPet.setHostState('working');
                  window.AgentPet.say(`Je m'occupe de : ${currentWork.title}`);
                } else if (!currentWork && lastTaskId !== null) {
                  // Tâche terminée !
                  lastTaskId = null;
                  window.AgentPet.setHostState('idle');
                  window.AgentPet.play('excited');
                  window.AgentPet.say("Tâche terminée ! Qu'est-ce qu'on fait maintenant ?");
                }
              })
              .catch(() => {});
          } catch (e) {}
        }, 5000);
      }

      // Recharger la page quand les paramètres de l'animal changent pour appliquer (ou masquer) le pet
      window.addEventListener('agent-pet:config-changed', () => {
        window.location.reload();
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPet);
      } else {
        initPet();
      }
    </script>
  </body>
</html>
