---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from "../layouts/DashboardLayout.astro";
import ActivityLive from "../components/home/ActivityLive";
import DashboardAppCenter from "../components/dashboard/DashboardAppCenter";
import AppLauncher from "../components/apps/AppLauncher";
import SyncProjectsButton from "../components/apps/SyncProjectsButton";
import DashboardGitPullAllButton from "../components/dashboard/DashboardGitPullAllButton";
import GithubImportModal from "../components/apps/GithubImportModal";
import PageHeader from "../components/ui/PageHeader.astro";
import EmptyStateCard from "../components/ui/EmptyStateCard.astro";
import { loadAstroDb } from "../lib/load-astro-db";

let projects = [];
try {
  const { db, Project, desc } = await loadAstroDb();
  projects = await db.select().from(Project).orderBy(desc(Project.updatedAt));
} catch {
  /* DB indisponible */
}
---

<DashboardLayout
  title="Tableau de bord - Applications"
  currentPath="/dashboard"
>
  <PageHeader
    title="Centre Nevralgique"
    description="Gerez vos applications, demarrez ou arretez vos services, et suivez les actions de vos agents."
    actions={[
      { href: '/work', label: 'Carnet de bord', tone: 'default' },
      { href: '/discussion', label: 'Ouvrir Discussion', tone: 'primary' },
    ]}
  />
  <div class="mb-8 flex flex-wrap items-center gap-3">
    <SyncProjectsButton client:load />
    <DashboardGitPullAllButton client:load />
    <GithubImportModal client:load />
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <div class="lg:col-span-3">
      <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
        <svg
          class="w-6 h-6 text-[#175B37]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
          ></path>
        </svg>
        Vos Applications
      </h2>

      {
        projects.length > 0 ? (
          <DashboardAppCenter client:load initialProjects={projects} />
        ) : (
          <EmptyStateCard
            title="Aucune application detectee"
            description="Synchronisez vos depots Git existants, ou laissez les agents creer un nouveau projet."
          >
            <div class="flex items-center justify-center gap-3">
              <>
                <SyncProjectsButton client:load />
                <DashboardGitPullAllButton client:load />
                <GithubImportModal client:load />
              </>
            </div>
          </EmptyStateCard>
        )
      }
    </div>

    <div class="lg:col-span-1">
      <div
        class="bg-[#175B37] text-white rounded-[1.5rem] p-6 shadow-sm mb-6 relative overflow-hidden"
      >
        <div class="absolute top-0 right-0 p-4 opacity-10">
          <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
            ></path>
          </svg>
        </div>
        <h3 class="text-lg font-bold mb-2 relative z-10">
          Créer une application
        </h3>
        <p class="text-sm text-green-100 mb-6 relative z-10">
          Laissez les agents générer un nouveau projet de A à Z.
        </p>
        <div class="relative z-10 text-gray-900">
          <AppLauncher client:load />
        </div>
      </div>

      <div
        class="bg-white rounded-[1.5rem] shadow-sm p-6 border border-gray-100 mb-6"
      >
        <h4 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
          <svg
            class="w-5 h-5 text-gray-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          Raccourcis
        </h4>
        <div class="space-y-3">
          <a
            href="/agents"
            class="flex items-center gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors text-sm font-medium text-gray-700"
          >
            <span
              class="w-8 h-8 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center"
              >🤖</span
            >
            Gérer les Agents
          </a>
          <a
            href="/settings"
            class="flex items-center gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors text-sm font-medium text-gray-700"
          >
            <span
              class="w-8 h-8 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center"
              >⚙️</span
            >
            Configuration serveur
          </a>
        </div>
      </div>

      <div>
        <ActivityLive client:load />
      </div>
    </div>
  </div>
</DashboardLayout>
