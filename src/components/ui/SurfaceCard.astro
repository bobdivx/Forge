---
interface Props {
  class?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  glow?: 'subtle' | 'strong';
}
const { class: className = '', padding = 'md' } = Astro.props;

const pad =
  padding === 'none' ? '' :
  padding === 'sm'   ? 'p-5 sm:p-6' :
  padding === 'lg'   ? 'p-8 sm:p-9' :
                       'p-6 sm:p-7';
---

<div class:list={['bg-white rounded-[1.5rem] shadow-sm', pad, className]}>
  <slot />
</div>
