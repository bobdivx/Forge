---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DashStatsRow from '../components/dashboard/DashStatsRow';
import DashActivity from '../components/dashboard/DashActivity';
import DashProposals from '../components/dashboard/DashProposals';
import DashProjectList from '../components/dashboard/DashProjectList';
import DashAgentTeam from '../components/dashboard/DashAgentTeam';
import DashAuditLog from '../components/dashboard/DashAuditLog';
import DashSystemStatus from '../components/dashboard/DashSystemStatus';
import { loadAstroDb } from '../lib/load-astro-db';

let recentProjects = [];
let projectTotalCount = 0;
try {
  const { db, Project, desc } = await loadAstroDb();
  const allProjects = await db.select().from(Project).orderBy(desc(Project.updatedAt));
  projectTotalCount = allProjects.length;
  recentProjects = allProjects.slice(0, 5);
} catch { /* DB indisponible */ }
---

<DashboardLayout title="Tableau de bord" currentPath="/dashboard">

  <!-- ── Page header ─────────────────────────────── -->
  <div class="flex justify-between items-end mb-6">
    <div>
      <h1 class="text-4xl font-bold mb-2 text-gray-900">Tableau de bord</h1>
      <p class="text-gray-500 text-sm">Planifiez, priorisez et pilotez vos projets depuis un seul endroit.</p>
    </div>
    <div class="flex gap-3 shrink-0">
      <a
        href="/apps"
        class="flex items-center gap-2 text-white text-sm font-medium px-6 py-2 rounded-full transition-colors hover:opacity-90"
        style="background:#175B37"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Nouveau projet
      </a>
      <a
        href="/agents"
        class="flex items-center gap-2 bg-white border border-gray-300 text-gray-700 text-sm font-medium px-6 py-2 rounded-full hover:bg-gray-50 transition-colors"
      >
        Synchroniser
      </a>
    </div>
  </div>

  <!-- ── Stats (4 cartes) ─────────────────────────── -->
  <div class="mb-5">
    <DashStatsRow client:load serverProjectTotal={projectTotalCount} />
  </div>

  <!-- ── Ligne 2 : Activité ── -->
  <div class="mb-5">
    <DashActivity client:load />
  </div>

  <!-- ── Ligne 3 : Projets (6/12) | Propositions (6/12) ── -->
  <div class="grid grid-cols-12 gap-5 mb-5">
    <div class="col-span-12 lg:col-span-6">
      <DashProjectList client:load projects={recentProjects} />
    </div>
    <div class="col-span-12 lg:col-span-6">
      <DashProposals client:load />
    </div>
  </div>

  <!-- ── Ligne 4 : Équipe (5/12) | Audit (4/12) | Système (3/12) ── -->
  <div class="grid grid-cols-12 gap-5">
    <div class="col-span-12 lg:col-span-5">
      <DashAgentTeam client:load />
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-4">
      <DashAuditLog client:load />
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
      <DashSystemStatus client:load />
    </div>
  </div>

</DashboardLayout>
