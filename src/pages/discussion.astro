---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DiscussionComposer from '../components/discussion/DiscussionComposer';
import PageHeader from '../components/ui/PageHeader.astro';
---

<DashboardLayout title="Hub de Communication (Swarm)" currentPath="/discussion">
  
  <div class="mx-auto max-w-6xl animate-fade-in px-1 pb-6 sm:px-0">
    <PageHeader
      title="Hub Swarm"
      description="Communiquez en direct avec vos agents. Envoyez des directives, partagez des retours et suivez la reponse en temps reel."
      actions={[
        { href: '/agents', label: 'Voir Equipe', tone: 'default' },
        { href: '/work', label: 'Carnet de bord', tone: 'primary' },
      ]}
    />
    <div class="mb-2 flex flex-wrap items-center justify-end gap-2">
      <div class="flex gap-2 items-center">
        <label class="text-xs text-gray-500" for="discussion-lang" data-i18n="discussion.languageLabel">Langue</label>
        <select id="discussion-lang" class="rounded-full border border-gray-200 bg-white px-2 py-1 text-xs text-gray-700">
          <option value="fr">FR</option>
          <option value="en">EN</option>
        </select>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
          <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
          <span data-i18n="discussion.gateway">Gateway ZimaOS Connectée</span>
        </span>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl animate-fade-in px-1 pb-10 sm:px-0 md:pb-14">
    <section class="rounded-[1.75rem] border border-gray-200/90 bg-[#ECEFF1]/40 p-1 shadow-sm ring-1 ring-black/[0.03] sm:p-2">
      <DiscussionComposer client:load />
    </section>
  </div>
  <script is:inline>
    const key = 'forge.ui.language';
    const dict = {
      fr: {
        'discussion.title': 'Hub Swarm',
        'discussion.subtitle': 'Communiquez en direct avec vos agents. Envoyez vos directives, partagez vos remarques ou demandez un point de situation.',
        'discussion.languageLabel': 'Langue',
        'discussion.gateway': 'Gateway ZimaOS Connectée',
      },
      en: {
        'discussion.title': 'Swarm Hub',
        'discussion.subtitle': 'Chat directly with your agents. Send directives, share feedback, or request a status update.',
        'discussion.languageLabel': 'Language',
        'discussion.gateway': 'ZimaOS Gateway Connected',
      },
    };
    const normalize = (v) => (String(v || '').toLowerCase() === 'en' ? 'en' : 'fr');
    const select = document.getElementById('discussion-lang');
    const applyLang = (lang) => {
      const safe = normalize(lang);
      const map = dict[safe];
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const k = el.getAttribute('data-i18n');
        if (k && map[k]) el.textContent = map[k];
      });
      if (select) select.value = safe;
      try {
        localStorage.setItem(key, safe);
        window.dispatchEvent(new CustomEvent('forge-ui-language-changed', { detail: { lang: safe } }));
      } catch {}
    };
    let initial = 'fr';
    try { initial = normalize(localStorage.getItem(key)); } catch {}
    applyLang(initial);
    if (select) {
      select.addEventListener('change', (e) => applyLang(e.target.value));
    }
  </script>
</DashboardLayout>
