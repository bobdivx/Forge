# Copier vers .env et adapter (non commité — voir .gitignore).

# URL Forge joignable depuis les autres conteneurs / scripts (prioritaire sur cette valeur en prod).
# Alternative sans toucher Docker : renseigner « URL Forge joignable par les agents » dans Paramètres (table Config forgePublicUrl).
# FORGE_HOOK_BASE_URL=http://forge-host:4321

# Forge → Gateway OpenClaw (API). Même machine : 127.0.0.1 suffit.
# Forge en Docker, OpenClaw sur l’hôte : souvent http://172.17.0.1:18789 (Linux) ou host.docker.internal (Docker Desktop).
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Doit correspondre à gateway.auth.token dans AppData/openclaw/openclaw.json
OPENCLAW_GATEWAY_TOKEN=

# Webhook GitHub (PR Jules) : priorité à la table Config « githubWebhookSecret » (Paramètres → Jetons API).
# GITHUB_WEBHOOK_SECRET=   # secours si la DB est vide
# Logins GitHub additionnels traités comme Jules (séparés par des virgules)
# JULES_GITHUB_LOGINS=
# Forcer la session OpenClaw qui reçoit les missions PR Jules (ex. agent:main:main)
# JULES_OPENCLAW_SESSION_KEY=agent:main:main
