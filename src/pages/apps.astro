---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import AppLauncher from '../components/apps/AppLauncher';
import SyncProjectsButton from '../components/apps/SyncProjectsButton';
import { loadAstroDb } from '../lib/load-astro-db';
import { getReposRootResolved } from '../lib/forge-repos';

const reposRootDisplay = await getReposRootResolved();

let deployedApps = [];
let requestCounts: Record<number, number> = {};
let issueCounts: Record<number, number> = {};

try {
  const { db, Project, Request, AgentAppIssue } = await loadAstroDb();
  deployedApps = await db.select().from(Project);
  deployedApps = deployedApps.map(app => ({
    ...app,
    lastSync: app.updatedAt
      ? new Date(app.updatedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })
      : 'N/A',
  })).sort((a, b) => (a.name === 'Forge' ? -1 : 1));

  const allRequests = await db.select().from(Request);
  for (const r of allRequests) {
    if (r.projectId) requestCounts[r.projectId] = (requestCounts[r.projectId] ?? 0) + 1;
  }
  const allIssues = await db.select().from(AgentAppIssue);
  for (const i of allIssues) {
    if (i.projectId) issueCounts[i.projectId] = (issueCounts[i.projectId] ?? 0) + 1;
  }
} catch { /* DB unavailable */ }

const totalActive = deployedApps.filter(a =>
  String(a.status).toLowerCase() === 'active' || String(a.status).toLowerCase() === 'online'
).length;
---

<DashboardLayout title="Projets" currentPath="/apps">
  <div class="max-w-7xl mx-auto space-y-6">

    <!-- En-tête -->
    <div class="flex items-end justify-between flex-wrap gap-4">
      <div>
        <h1 class="text-4xl font-bold mb-2 text-gray-900">Projets</h1>
        <p class="text-gray-500 text-sm">
          Applications développées par l'équipe. Chaque projet reçoit des demandes, bugs et propositions via la DB Forge.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <SyncProjectsButton client:load />
        <a
          href="/work"
          class="flex items-center gap-2 border border-gray-300 text-gray-700 text-sm font-medium px-4 py-2 rounded-full hover:bg-gray-50 transition-colors bg-white"
        >
          Carnet de bord →
        </a>
      </div>
    </div>

    <!-- KPIs rapides -->
    <div class="grid grid-cols-3 gap-5">
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Projets</span>
        <span class="text-5xl font-bold text-gray-900">{deployedApps.length}</span>
        <span class="text-xs text-gray-400 block mt-2">en base Forge</span>
      </div>
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Actifs</span>
        <span class="text-5xl font-bold" style="color:#3BAE61">{totalActive}</span>
        <span class="text-xs text-gray-400 block mt-2">status online/active</span>
      </div>
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Répertoire</span>
        <span class="text-sm font-mono truncate block mt-2" style="color:#175B37">{reposRootDisplay || '—'}</span>
        <span class="text-xs text-gray-400 block mt-1">applications (sync Git)</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Grille projets -->
      <div class="lg:col-span-2">
        {deployedApps.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {deployedApps.map(app => {
              const reqCount = requestCounts[app.id] ?? 0;
              const issCount = issueCounts[app.id] ?? 0;
              return (
                <a
                  href={`/apps/by-id/${app.id}`}
                  class="group bg-white rounded-[1.5rem] shadow-sm p-5 hover:shadow-md transition-shadow block no-underline text-inherit border border-gray-100 hover:border-gray-200"
                >
                  <div class="flex justify-between items-start mb-4">
                    <div class="flex items-center gap-3">
                      <div
                        class="h-10 w-10 rounded-full flex items-center justify-center font-bold text-lg text-white shrink-0"
                        style="background:#175B37"
                      >
                        {app.name.charAt(0).toUpperCase()}
                      </div>
                      <div>
                        <h3 class="font-semibold text-gray-900 group-hover:text-[#175B37] transition-colors text-sm">{app.name}</h3>
                        <span class="text-[10px] text-gray-400 font-mono">{app.path?.split('/').pop() ?? app.name}</span>
                      </div>
                    </div>
                    <span class={`text-[10px] font-semibold px-2 py-1 rounded-full ${
                      String(app.status).toLowerCase() === 'active' || String(app.status).toLowerCase() === 'online'
                        ? 'bg-green-50 text-green-600'
                        : 'bg-gray-100 text-gray-500'
                    }`}>{app.status || 'actif'}</span>
                  </div>

                  <div class="flex items-center gap-4 pt-3 border-t border-gray-100">
                    {reqCount > 0 && (
                      <span class="flex items-center gap-1 text-[11px] text-yellow-600">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                        {reqCount} demande{reqCount > 1 ? 's' : ''}
                      </span>
                    )}
                    {issCount > 0 && (
                      <span class="flex items-center gap-1 text-[11px] text-red-500">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        {issCount} bug{issCount > 1 ? 's' : ''}
                      </span>
                    )}
                    <span class="ml-auto text-[10px] text-gray-400">Sync: {app.lastSync}</span>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="bg-white rounded-[1.5rem] shadow-sm p-10 flex flex-col items-center gap-4 text-center border border-gray-100">
            <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center">
              <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-10.5v9" />
              </svg>
            </div>
            <p class="text-gray-600 text-sm">Aucun projet en base de données.</p>
            <p class="text-gray-400 text-xs max-w-sm">
              Cliquez sur <strong class="font-semibold" style="color:#175B37">⟳ Synchroniser</strong> pour scanner
              <code class="font-mono text-gray-600 mx-1 break-all">{reposRootDisplay}</code>
              et importer les dépôts Git.
            </p>
            <SyncProjectsButton client:load />
          </div>
        )}
      </div>

      <!-- Colonne latérale : nouveau projet -->
      <div>
        <div class="bg-white rounded-[1.5rem] shadow-sm overflow-hidden border border-gray-100">
          <div class="p-5 border-b border-gray-100">
            <h4 class="text-sm font-semibold text-gray-900">Nouveau projet</h4>
            <p class="text-xs text-gray-400 mt-1">Demander à OpenClaw de créer et scaffolder une nouvelle application.</p>
          </div>
          <div class="p-5">
            <AppLauncher client:load />
          </div>
        </div>
      </div>

    </div>
  </div>
</DashboardLayout>
