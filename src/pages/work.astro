---
// @ts-nocheck
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { loadAstroDb } from '../lib/load-astro-db';
import WorkModals from '../components/work/WorkModals';
import WorkSystemPanel from '../components/work/WorkSystemPanel';
import WorkAgentTasksPanel from '../components/work/WorkAgentTasksPanel';
import WorkAnalyticsHeader from '../components/work/WorkAnalyticsHeader';
import BugFlowBoard from '../components/work/BugFlowBoard';
import AgentIdeasBoard from '../components/work/AgentIdeasBoard';
import WorkCarnetRest from '../components/work/WorkCarnetRest';
import WorkDiagnosticPanel from '../components/work/WorkDiagnosticPanel';
import SwarmProjectsToggle from '../components/work/SwarmProjectsToggle';
import WorkSimpleStory from '../components/work/WorkSimpleStory';
import PageHeader from '../components/ui/PageHeader.astro';
import WorkHeaderProcessQueueButton from '../components/work/WorkHeaderProcessQueueButton';

let requests = [];
let issues = [];
let deps = [];
let projects: Record<number, string> = {};
let projectOptions: { id: number; name: string }[] = [];

try {
  const { db, Request, AgentAppIssue, AgentDependencyRequest, Project, desc } = await loadAstroDb();
  const projectRows = await db.select().from(Project);
  for (const p of projectRows) {
    projects[p.id] = p.name;
    projectOptions.push({ id: p.id, name: p.name });
  }
  requests = await db.select().from(Request).orderBy(desc(Request.createdAt));
  issues   = await db.select().from(AgentAppIssue).orderBy(desc(AgentAppIssue.createdAt));
  deps     = await db.select().from(AgentDependencyRequest).orderBy(desc(AgentDependencyRequest.createdAt));
} catch(e) { console.error('WORK PAGE DB ERROR:', e); }

const openIssues       = issues.filter(i => i.status === 'open' || i.status === 'in_progress');
const openDeps         = deps.filter(d => d.status === 'open' || d.status === 'in_progress');
const pendingRequests  = requests.filter(r => r.status === 'pending' || r.status === 'in_progress');
const finishedRequests = requests.filter(r => r.status === 'completed' || r.status === 'rejected');
const finishedIssues   = issues.filter(i => i.status === 'resolved' || i.status === 'wont_fix');
const finishedDeps     = deps.filter(d => d.status === 'installed' || d.status === 'rejected');

// Sérialise les données pour le registre global JS
const requestsJson  = JSON.stringify(requests.map(r => ({ ...r, _type: 'request', createdAt: r.createdAt ? new Date(r.createdAt).toISOString() : null })));
const issuesJson    = JSON.stringify(issues.map(i => ({ ...i, _type: 'issue', createdAt: i.createdAt ? new Date(i.createdAt).toISOString() : null })));
const depsJson      = JSON.stringify(deps.map(d => ({ ...d, _type: 'dep', createdAt: d.createdAt ? new Date(d.createdAt).toISOString() : null })));
---

<DashboardLayout title="Carnet de Commandes (Tasks)" currentPath="/work">

  <!-- Registre global des données (pour les modals détail) -->
  <script define:vars={{ requestsJson, issuesJson, depsJson }}>
    window.__workData = {
      requests: JSON.parse(requestsJson),
      issues:   JSON.parse(issuesJson),
      deps:     JSON.parse(depsJson),
    };
    window.__openWorkDetail = function(type, id) {
      const item = window.__workData[type + 's']?.find(x => x.id === id)
                ?? window.__workData[type]?.find(x => x.id === id);
      if (item && window.__openWorkDetailModal) window.__openWorkDetailModal(item);
    };
    window.__deleteWorkItems = async function(itemType, scope, count, label) {
      if (!count) return;
      const suffix = scope === 'all' ? 'toutes les entrées' : 'ce lot';
      if (!window.confirm(`Supprimer ${suffix} ${label} (${count}) ?`)) return;
      try {
        const res = await fetch('/api/work-items-actions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'deleteWorkItems', itemType, scope }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || `Erreur ${res.status}`);
        window.location.reload();
      } catch (e) {
        window.alert(e instanceof Error ? e.message : String(e));
      }
    };
  </script>

  <div class="max-w-7xl mx-auto space-y-6">

    <!-- En-tête -->
    <PageHeader
      title="Carnet de Commandes"
      description="Commencez par le fil simple (app, PR/CI, agent, etape), puis ouvrez la vue avancee pour le detail technique."
      actions={[
        { href: '/discussion', label: 'Discussion', tone: 'default' },
        { href: '/agents#swarm-flux', label: 'Fil d activite', tone: 'primary' },
      ]}
    >
      <WorkHeaderProcessQueueButton slot="actionsAppend" client:load />
    </PageHeader>

    <!-- KPIs -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Demandes</span>
        <span class="text-5xl font-bold text-gray-900">{requests.length}</span>
        <span class={`text-xs block mt-2 ${pendingRequests.length > 0 ? 'text-yellow-600' : 'text-gray-400'}`}>
          {pendingRequests.length} en attente
        </span>
      </div>
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Bugs</span>
        <span class="text-5xl font-bold" style={`color:${openIssues.length > 0 ? '#EF4444' : '#9CA3AF'}`}>{issues.length}</span>
        <span class={`text-xs block mt-2 ${openIssues.length > 0 ? 'text-red-500' : 'text-gray-400'}`}>
          {openIssues.length} ouverts
        </span>
      </div>
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Propositions</span>
        <span class="text-5xl font-bold" style="color:#8B5CF6">
          {requests.filter(r => r.requestType === 'feature_proposal' || r.requestType === 'Fonctionnalite').length}
        </span>
        <span class="text-xs text-gray-400 block mt-2">fonctionnalités suggérées</span>
      </div>
      <div class="bg-white rounded-[1.5rem] shadow-sm p-5">
        <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-2">Dépendances</span>
        <span class="text-5xl font-bold" style={`color:${openDeps.length > 0 ? '#3B82F6' : '#9CA3AF'}`}>{deps.length}</span>
        <span class={`text-xs block mt-2 ${openDeps.length > 0 ? 'text-blue-500' : 'text-gray-400'}`}>
          {openDeps.length} à installer
        </span>
      </div>
    </div>

    <WorkSimpleStory client:load />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-start">
      <SwarmProjectsToggle client:load />
      <WorkSystemPanel client:load />
    </div>

    <details class="group rounded-[1.5rem] border border-gray-200 bg-gray-50/70 p-4 shadow-sm">
      <summary class="cursor-pointer list-none flex flex-wrap items-center justify-between gap-2 text-sm font-semibold text-gray-800 [&::-webkit-details-marker]:hidden">
        <span class="flex items-center gap-2">
          <span class="text-gray-400 transition group-open:rotate-90">▸</span>
          Vue avancée — tâches brutes, diagnostic, graphiques, carnet détaillé
        </span>
        <span class="text-xs font-normal text-gray-500">repliable · tout ce qui était visible avant</span>
      </summary>
      <div class="mt-5 space-y-6 border-t border-gray-200/80 pt-5">

        <WorkDiagnosticPanel client:load />

        <WorkAgentTasksPanel client:load />

        <section class="space-y-4">
          <div class="flex items-center gap-3 flex-wrap">
            <div class="w-1 h-6 rounded-full bg-[#175B37]"></div>
            <h2 class="text-lg font-bold text-gray-900">Analytique carnet</h2>
            <a href="/agents#swarm-flux" class="text-xs font-medium px-3 py-1.5 rounded-full border border-gray-200 text-gray-600 hover:bg-gray-50 ml-auto">
              Chronologie Forge
            </a>
          </div>
          <WorkAnalyticsHeader client:load />
        </section>

        <section class="space-y-4">
          <div class="flex items-center gap-3 mb-2 flex-wrap">
            <div class="w-1 h-6 rounded-full bg-red-400"></div>
            <h2 class="text-lg font-bold text-gray-900">Bugs &amp; anomalies — flux</h2>
            <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full font-medium">{issues.length}</span>
            <div class="flex-1"></div>
            <button
              type="button"
              disabled={openIssues.length === 0}
              onclick={`window.__deleteWorkItems && window.__deleteWorkItems('issue', 'active', ${openIssues.length}, 'bugs ouverts')`}
              class="min-h-[44px] rounded-full border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 disabled:opacity-40"
            >Supprimer lot ouverts</button>
            <button
              type="button"
              disabled={finishedIssues.length === 0}
              onclick={`window.__deleteWorkItems && window.__deleteWorkItems('issue', 'finished', ${finishedIssues.length}, 'bugs clôturés')`}
              class="min-h-[44px] rounded-full border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 disabled:opacity-40"
            >Clôturés</button>
            <button
              type="button"
              disabled={issues.length === 0}
              onclick={`window.__deleteWorkItems && window.__deleteWorkItems('issue', 'all', ${issues.length}, 'bugs')`}
              class="min-h-[44px] rounded-full border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 disabled:opacity-40"
            >Tout supprimer</button>
            <button
              type="button"
              onclick="window.__openWorkModal && window.__openWorkModal('issue')"
              class="flex h-11 w-11 items-center justify-center rounded-full text-lg font-bold text-white shadow-sm"
              style="background:#EF4444"
              title="Signaler un bug"
            >+</button>
          </div>
          <BugFlowBoard client:load />
        </section>

        <section class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-1 h-6 rounded-full bg-amber-400"></div>
            <h2 class="text-lg font-bold text-gray-900">Idées &amp; améliorations (agents)</h2>
          </div>
          <AgentIdeasBoard client:load />
        </section>

        <WorkCarnetRest client:load />
      </div>
    </details>

  </div>

  <!-- Modals Preact island -->
  <WorkModals projects={projectOptions} client:load />

</DashboardLayout>
