---
import '../styles/global.css';

const { title = 'Configuration Forge' } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | DevForge</title>
  </head>
  <body class="min-h-full antialiased font-sans text-gray-900" style="background:#F4F7F5">
    <header class="flex items-center justify-between px-5 sm:px-8 py-4 border-b border-gray-200 bg-white/90 backdrop-blur-sm">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-9 h-9 rounded-full border-2 flex items-center justify-center shrink-0" style="border-color:#3BAE61">
          <div class="w-4 h-4 rounded-full" style="background:#175B37"></div>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-bold uppercase tracking-widest text-gray-400 truncate">Premier lancement</p>
          <p class="text-sm font-semibold text-gray-900 truncate">{title}</p>
        </div>
      </div>
      <a
        href="/api/auth/logout"
        class="text-xs sm:text-sm text-gray-500 hover:text-gray-800 shrink-0 rounded-full px-3 py-1.5 border border-gray-200 hover:bg-gray-50 transition-colors"
      >
        Déconnexion
      </a>
    </header>
    <main class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
      <slot />
    </main>
  </body>
</html>
