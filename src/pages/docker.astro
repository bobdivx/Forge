---
export const prerender = false;
import DashboardLayout from '../layouts/DashboardLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
---

<DashboardLayout title="Supervision Docker" currentPath="/docker">
  <PageHeader
    title="Supervision Docker"
    description="Consultez l'etat des conteneurs CasaOS et declenchez des actions rapides."
  />

  <div class="rounded-[1.5rem] border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg font-semibold text-gray-900">Conteneurs actifs</h2>
      <button id="refresh-btn" class="btn btn-sm min-h-[44px] rounded-full border border-gray-300 bg-white px-4 text-gray-700 hover:bg-gray-50">
        Rafraîchir
      </button>
    </div>

    <div class="hidden overflow-x-auto md:block">
      <table class="w-full text-left text-sm text-gray-700">
        <thead class="bg-gray-50 text-xs font-semibold uppercase text-gray-500">
          <tr>
            <th class="px-4 py-3 rounded-tl-lg">Nom</th>
            <th class="px-4 py-3">Image</th>
            <th class="px-4 py-3">Statut</th>
            <th class="px-4 py-3">Ports</th>
            <th class="px-4 py-3 text-right rounded-tr-lg">Actions</th>
          </tr>
        </thead>
        <tbody id="containers-body" class="divide-y divide-gray-100">
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-gray-500">
              <span class="loading loading-spinner loading-md text-[#175B37]"></span>
              <p class="mt-2">Chargement des conteneurs...</p>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div id="containers-cards" class="space-y-3 md:hidden">
      <div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-6 text-center text-sm text-gray-500">
        Chargement des conteneurs...
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  // @ts-nocheck
  const tbody = document.getElementById('containers-body');
  const cardsRoot = document.getElementById('containers-cards');
  const refreshBtn = document.getElementById('refresh-btn');

  async function fetchContainers() {
    try {
      tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-gray-500"><span class="loading loading-spinner loading-md text-[#175B37]"></span><p class="mt-2">Chargement...</p></td></tr>`;
      cardsRoot.innerHTML = `<div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-6 text-center text-sm text-gray-500">Chargement...</div>`;
      const res = await fetch('/api/docker/containers');
      if (!res.ok) throw new Error("Erreur de chargement");
      const containers = await res.json();
      renderContainers(containers);
    } catch (err) {
      tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-red-600">Impossible de charger les conteneurs : ${err.message}</td></tr>`;
      cardsRoot.innerHTML = `<div class="rounded-2xl border border-red-100 bg-red-50 px-4 py-6 text-center text-sm text-red-600">Impossible de charger les conteneurs : ${err.message}</div>`;
    }
  }

  function getStatusBadge(state, status) {
    if (state === 'running' && !status.includes('unhealthy')) {
      return `<span class="inline-flex items-center gap-1.5 rounded-md border border-emerald-200 bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>En ligne</span>`;
    }
    if (state === 'restarting') {
      return `<span class="inline-flex items-center gap-1.5 rounded-md border border-orange-200 bg-orange-50 px-2 py-1 text-xs font-medium text-orange-700"><span class="h-1.5 w-1.5 rounded-full bg-orange-500"></span>Redemarrage</span>`;
    }
    if (status.includes('unhealthy')) {
      return `<span class="inline-flex items-center gap-1.5 rounded-md border border-amber-200 bg-amber-50 px-2 py-1 text-xs font-medium text-amber-700"><span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>Instable</span>`;
    }
    return `<span class="inline-flex items-center gap-1.5 rounded-md border border-red-200 bg-red-50 px-2 py-1 text-xs font-medium text-red-700"><span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>Arrete</span>`;
  }

  function formatPorts(ports) {
    if (!ports || ports.length === 0) return '-';
    return ports.map(p => {
      if (p.PublicPort) return `<span class="font-semibold text-[#175B37]">${p.PublicPort}</span>:${p.PrivatePort}`;
      return p.PrivatePort;
    }).join(', ');
  }

  function renderContainers(containers) {
    if (!containers || containers.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-gray-500">Aucun conteneur trouve.</td></tr>`;
      cardsRoot.innerHTML = `<div class="rounded-2xl border border-gray-100 bg-gray-50 px-4 py-6 text-center text-sm text-gray-500">Aucun conteneur trouve.</div>`;
      return;
    }

    tbody.innerHTML = containers.map(c => {
      const name = c.Names[0].replace('/', '');
      return `
        <tr class="group transition-colors hover:bg-gray-50">
          <td class="px-4 py-3 font-medium text-gray-900">${name}</td>
          <td class="max-w-[180px] truncate px-4 py-3 font-mono text-xs text-gray-500" title="${c.Image}">${c.Image}</td>
          <td class="px-4 py-3">${getStatusBadge(c.State, c.Status)}<div class="mt-1 text-[10px] text-gray-500">${c.Status}</div></td>
          <td class="px-4 py-3 text-xs font-mono">${formatPorts(c.Ports)}</td>
          <td class="px-4 py-3 text-right">
            <div class="flex justify-end gap-2 opacity-100 transition-opacity md:opacity-70 md:group-hover:opacity-100">
              <button onclick="actionContainer('${c.Id}', 'restart')" aria-label="Redémarrer le conteneur" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-600 transition hover:bg-[#E9F3EB] hover:text-[#175B37]" title="Redemarrer">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
              </button>
              <button onclick="actionContainer('${c.Id}', 'stop')" aria-label="Arrêter le conteneur" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-600 transition hover:bg-orange-50 hover:text-orange-600" title="Arreter">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" /></svg>
              </button>
              <button onclick="if(confirm('Supprimer ce conteneur ?')) actionContainer('${c.Id}', 'remove')" aria-label="Supprimer le conteneur" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-600 transition hover:bg-red-50 hover:text-red-600" title="Supprimer">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    cardsRoot.innerHTML = containers.map((c) => {
      const name = c.Names[0].replace('/', '');
      return `
        <article class="rounded-2xl border border-gray-100 bg-white p-4 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="font-semibold text-gray-900">${name}</p>
              <p class="mt-1 text-xs font-mono text-gray-500 break-all">${c.Image}</p>
            </div>
            ${getStatusBadge(c.State, c.Status)}
          </div>
          <p class="mt-2 text-xs text-gray-500">${c.Status}</p>
          <p class="mt-3 text-xs font-mono text-gray-700">Ports: ${formatPorts(c.Ports)}</p>
          <div class="mt-4 grid grid-cols-3 gap-2">
            <button onclick="actionContainer('${c.Id}', 'restart')" class="min-h-[44px] rounded-lg border border-gray-200 bg-white text-xs font-medium text-gray-700 hover:bg-[#E9F3EB] hover:text-[#175B37]">Relancer</button>
            <button onclick="actionContainer('${c.Id}', 'stop')" class="min-h-[44px] rounded-lg border border-gray-200 bg-white text-xs font-medium text-gray-700 hover:bg-orange-50 hover:text-orange-600">Arreter</button>
            <button onclick="if(confirm('Supprimer ce conteneur ?')) actionContainer('${c.Id}', 'remove')" class="min-h-[44px] rounded-lg border border-gray-200 bg-white text-xs font-medium text-gray-700 hover:bg-red-50 hover:text-red-600">Supprimer</button>
          </div>
        </article>
      `;
    }).join('');
  }

  window.actionContainer = async (id, action) => {
    try {
      const res = await fetch('/api/docker/containers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, action })
      });
      if (res.ok) {
        fetchContainers();
      } else {
        alert('Erreur lors de l\'action sur le conteneur');
      }
    } catch (err) {
      alert('Erreur réseau');
    }
  };

  refreshBtn.addEventListener('click', fetchContainers);
  
  // Initial load
  fetchContainers();
  
  // Auto-refresh every 10s
  setInterval(fetchContainers, 10000);
</script>
