---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import SettingsForm from '../components/settings/SettingsForm';
import PageHeader from '../components/ui/PageHeader.astro';
---
<DashboardLayout title="Paramètres" currentPath="/settings">
  <div class="max-w-4xl mx-auto space-y-6">
    <PageHeader
      title="Parametres"
      description="Intégration, jetons API, modèles des agents, compte et maintenance. Les spécifications OpenSpec du dépôt (specs versionnées) sont résumées sur Instructions — raccourci OpenSpec ci-dessous."
      actions={[
        { href: '/agents/instructions', label: 'Instructions agents', tone: 'default' },
        { href: '/agents/instructions#openspec-panel', label: 'OpenSpec', tone: 'default' },
        { href: '/help', label: 'Aide', tone: 'primary' },
      ]}
    />

    <SettingsForm client:load />

  </div>
</DashboardLayout>
