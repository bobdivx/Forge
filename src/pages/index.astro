---
import '../styles/global.css';

const year = new Date().getFullYear();
---

<html lang="fr" class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DevForge - La Forge Logicielle Autonome</title>
    <meta name="description" content="Pilotez OpenClaw, Ollama et Gemini pour vos déploiements sur infrastructure propre." />
  </head>
  <body class="relative min-h-screen bg-slate-950 text-white selection:bg-cyan-500/30 font-sans antialiased">
    <div class="forge-backdrop" aria-hidden="true"></div>
    <div class="forge-grid" aria-hidden="true"></div>
    <div class="drawer drawer-end relative z-10">
      <input id="landing-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content flex flex-col">
        <!-- Navbar -->
        <nav class="sticky top-0 z-50 w-full border-b border-cyan-500/20 bg-white/[0.05] backdrop-blur-xl shadow-glass-inset">
          <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
            <div class="flex items-center gap-2">
              <div class="h-8 w-8 rounded-lg bg-cyan-500/15 border border-cyan-400/35 flex items-center justify-center font-bold text-sm text-cyan-200 shadow-neon-cyan">F</div>
              <span class="text-xl font-bold tracking-tight text-white forge-text-glow">DevForge</span>
            </div>
            <div class="hidden md:flex gap-8 text-sm font-medium text-slate-300">
              <a href="#features" class="hover:text-cyan-300 transition drop-shadow-[0_0_8px_rgba(34,211,238,0.25)]">Fonctionnalités</a>
              <a href="#stack" class="hover:text-cyan-300 transition drop-shadow-[0_0_8px_rgba(34,211,238,0.25)]">Stack</a>
              <a href="#pricing" class="hover:text-cyan-300 transition drop-shadow-[0_0_8px_rgba(34,211,238,0.25)]">Tarifs</a>
            </div>
            <div class="hidden md:flex items-center gap-4">
              <a href="/docker" class="text-sm font-medium text-slate-300 hover:text-cyan-300 transition drop-shadow-[0_0_8px_rgba(34,211,238,0.25)]">Supervision Docker</a>
              <a href="/login" class="text-sm font-medium text-slate-300 hover:text-cyan-200 transition">Connexion</a>
              <a href="/apps" class="rounded-lg border border-cyan-400/40 bg-cyan-500/15 px-4 py-2 text-sm font-semibold text-cyan-100 hover:bg-cyan-500/25 hover:border-cyan-300/50 transition shadow-neon-cyan">
                Accéder au Dashboard
              </a>
            </div>
            <label for="landing-drawer" class="btn btn-ghost btn-square btn-sm md:hidden text-cyan-200/90 border border-cyan-500/20 hover:bg-cyan-500/10">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </label>
          </div>
        </nav>

        <!-- Hero Section -->
        <main>
      <section class="relative overflow-hidden pt-32 pb-20 lg:pt-48 lg:pb-32">
        <div class="absolute inset-0 bg-forge-mesh opacity-70 pointer-events-none"></div>
        <div class="absolute -top-24 -left-24 h-96 w-96 rounded-full bg-cyan-500/25 blur-[120px] pointer-events-none"></div>
        <div class="absolute top-1/2 right-0 h-96 w-96 -translate-y-1/2 rounded-full bg-fuchsia-600/20 blur-[120px] pointer-events-none"></div>

        <div class="relative mx-auto max-w-7xl px-6 text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-cyan-400/35 bg-cyan-500/10 px-3 py-1 mb-8 shadow-[0_0_24px_rgba(34,211,238,0.15)] backdrop-blur-md">
            <span class="flex h-2 w-2 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_10px_rgba(34,211,238,0.9)]"></span>
            <span class="text-xs font-medium text-cyan-200/90">OpenClaw · Ollama · Gemini (selon votre config)</span>
          </div>
          
          <h1 class="mx-auto max-w-4xl text-5xl font-extrabold tracking-tight text-white sm:text-7xl">
            L'usine logicielle <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-fuchsia-300 to-cyan-400 forge-text-glow">entièrement autonome</span>
          </h1>
          
          <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-300">
            De l'idée au déploiement en production. Le tableau de bord affiche les sessions et l'état réels renvoyés par votre gateway OpenClaw une fois connecté.
          </p>
          
          <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
            <a href="/apps" class="rounded-xl border border-cyan-400/40 bg-cyan-500/15 px-8 py-3.5 text-sm font-semibold text-cyan-50 hover:bg-cyan-500/25 hover:border-cyan-300/55 transition shadow-neon-cyan-lg backdrop-blur-sm">
              Démarrer un projet
            </a>
            <a href="#demo" class="rounded-xl forge-glass-panel px-8 py-3.5 text-sm font-semibold text-white hover:border-fuchsia-400/30 transition shadow-neon-card">
              Voir la Démo
            </a>
          </div>
          
          <p id="demo" class="sr-only">Démo</p>
          <div id="stack" class="mt-20 mx-auto max-w-5xl rounded-2xl forge-glass-panel p-2 shadow-neon-card-lg">
            <p class="text-center text-[10px] uppercase tracking-widest text-cyan-500/50 px-2 pt-2">
              Illustration — les vues connectées lisent les données OpenClaw (sessions, gateway), pas des scénarios fictifs
            </p>
            <div class="rounded-xl overflow-hidden bg-slate-950/80 border border-cyan-500/15 relative mt-2 shadow-[inset_0_0_40px_rgba(34,211,238,0.04)]">
               <div class="absolute top-0 w-full h-8 bg-white/[0.04] border-b border-cyan-500/15 flex items-center px-4 gap-2 backdrop-blur-sm">
                 <div class="w-3 h-3 rounded-full bg-red-500/90 shadow-[0_0_8px_rgba(239,68,68,0.6)]"></div>
                 <div class="w-3 h-3 rounded-full bg-amber-400/90 shadow-[0_0_8px_rgba(251,191,36,0.5)]"></div>
                 <div class="w-3 h-3 rounded-full bg-emerald-400/90 shadow-[0_0_8px_rgba(52,211,153,0.5)]"></div>
               </div>
               <div class="pt-8 p-6 text-left font-mono text-sm text-slate-400">
                 <p class="text-cyan-400 drop-shadow-[0_0_6px_rgba(34,211,238,0.45)]">GET /health → sessions réelles (jeton OpenClaw)</p>
                 <p class="mt-2">The Wire → lignes dérivées des sessions actives / veille</p>
                 <p class="mt-2 text-slate-500">Paramètres : token gateway + option <span class="text-slate-400">OPENCLAW_GATEWAY_URL</span></p>
               </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Features Section -->
      <section id="features" class="py-24 border-y border-cyan-500/10 bg-white/[0.02] backdrop-blur-sm">
        <div class="mx-auto max-w-7xl px-6">
          <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl forge-text-glow">Conçu pour la productivité absolue</h2>
            <p class="mt-4 text-slate-400">Vos agents OpenClaw orchestrent le cycle de vie des applications ; la Forge affiche ce que le gateway expose réellement.</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="forge-glass-panel rounded-2xl p-8 shadow-neon-card hover:border-cyan-400/40 hover:shadow-[0_0_32px_rgba(34,211,238,0.18)] transition duration-300">
              <div class="w-12 h-12 rounded-lg bg-cyan-500/15 border border-cyan-400/30 flex items-center justify-center mb-6 shadow-neon-cyan">
                <svg class="w-6 h-6 text-cyan-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-white mb-3">Code Généré par l'IA</h3>
              <p class="text-slate-400 leading-relaxed">Modèles locaux Ollama (ex. Qwen) et Gemini côté Google, selon votre openclaw.json — ce dashboard n'invente pas de charge GPU ni de modèle.</p>
            </div>
            
            <div class="forge-glass-panel rounded-2xl p-8 shadow-neon-card hover:border-fuchsia-400/35 hover:shadow-[0_0_32px_rgba(192,38,211,0.15)] transition duration-300">
              <div class="w-12 h-12 rounded-lg bg-fuchsia-500/15 border border-fuchsia-400/30 flex items-center justify-center mb-6 shadow-neon-fuchsia">
                <svg class="w-6 h-6 text-fuchsia-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-white mb-3">Déploiement ZimaOS</h3>
              <p class="text-slate-400 leading-relaxed">Intégration native avec CasaOS/ZimaOS. Les agents génèrent les `docker-compose.yml` et configurent automatiquement l'infrastructure.</p>
            </div>
            
            <div class="forge-glass-panel rounded-2xl p-8 shadow-neon-card hover:border-cyan-400/40 hover:shadow-neon-cyan-lg transition duration-300">
              <div class="w-12 h-12 rounded-lg bg-violet-500/15 border border-violet-400/30 flex items-center justify-center mb-6 shadow-[0_0_20px_rgba(139,92,246,0.25)]">
                <svg class="w-6 h-6 text-violet-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-white mb-3">Autonomie & Sécurité</h3>
              <p class="text-slate-400 leading-relaxed">La forge s'auto-régule. Les agents font des PR, effectuent des revues de sécurité, et maintiennent le code sans intervention humaine.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Pricing / Plans -->
      <section id="pricing" class="py-24 relative">
        <div class="mx-auto max-w-7xl px-6">
          <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl forge-text-glow-fuchsia">Hébergez l'intelligence</h2>
            <p class="mt-4 text-slate-400">Choisissez le plan adapté à vos besoins de production logicielle.</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            <!-- Plan 1 -->
            <div class="forge-glass-panel rounded-2xl p-8 flex flex-col shadow-neon-card">
              <h3 class="text-xl font-semibold text-white mb-2">Self-Hosted</h3>
              <p class="text-slate-400 text-sm mb-6">Pour les NAS personnels et ZimaBoard.</p>
              <div class="text-4xl font-bold text-white mb-6">0€ <span class="text-lg font-normal text-slate-500">/mois</span></div>
              <ul class="space-y-3 mb-8 flex-1 text-slate-300 text-sm">
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> OpenClaw + Ollama / Gemini (self-host)</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Déploiements illimités</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Intégration GitHub</li>
              </ul>
              <a href="/apps" class="block w-full text-center rounded-xl border border-cyan-500/25 bg-white/[0.06] px-4 py-2.5 text-sm font-semibold text-cyan-100 hover:bg-cyan-500/10 hover:border-cyan-400/40 transition shadow-glass-inset">Commencer gratuitement</a>
            </div>
            
            <!-- Plan 2 -->
            <div class="forge-glass-panel rounded-2xl p-8 flex flex-col relative overflow-hidden border-2 border-cyan-400/45 shadow-neon-card-lg">
              <div class="absolute top-0 right-0 bg-gradient-to-l from-cyan-500 to-fuchsia-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg uppercase tracking-wider shadow-[0_0_20px_rgba(34,211,238,0.4)]">Populaire</div>
              <h3 class="text-xl font-semibold text-white mb-2">Cloud Forge</h3>
              <p class="text-slate-400 text-sm mb-6">Pour les entreprises et freelances.</p>
              <div class="text-4xl font-bold text-white mb-6">49€ <span class="text-lg font-normal text-slate-500">/mois</span></div>
              <ul class="space-y-3 mb-8 flex-1 text-slate-300 text-sm">
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-cyan-400 drop-shadow-[0_0_6px_rgba(34,211,238,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Extensions cloud optionnelles (selon plugins OpenClaw)</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-cyan-400 drop-shadow-[0_0_6px_rgba(34,211,238,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Cluster GPU Dédié</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-cyan-400 drop-shadow-[0_0_6px_rgba(34,211,238,0.5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Auto-Scaling ZimaOS</li>
                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-fuchsia-400 drop-shadow-[0_0_6px_rgba(217,70,239,0.45)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Support prioritaire Slack</li>
              </ul>
              <a href="#" class="block w-full text-center rounded-xl border border-cyan-300/50 bg-gradient-to-r from-cyan-500/30 to-fuchsia-500/25 px-4 py-2.5 text-sm font-semibold text-white hover:from-cyan-500/40 hover:to-fuchsia-500/35 transition shadow-neon-cyan-lg">S'abonner</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-cyan-500/15 py-12 mt-12 bg-white/[0.03] backdrop-blur-xl">
      <div class="mx-auto max-w-7xl px-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <div class="h-6 w-6 rounded-md bg-cyan-500/20 border border-cyan-400/35 flex items-center justify-center font-bold text-[10px] text-cyan-200 shadow-neon-cyan">F</div>
          <span class="text-sm font-semibold text-slate-200">DevForge Inc.</span>
        </div>
        <p class="text-slate-500 text-sm">© {year} DevForge SaaS. Créé avec les Agents IA.</p>
        <div class="flex gap-4 text-sm text-slate-400">
          <a href="#" class="hover:text-cyan-300 transition">Conditions</a>
          <a href="#" class="hover:text-cyan-300 transition">Confidentialité</a>
          <a href="#" class="hover:text-cyan-300 transition">Contact</a>
        </div>
      </div>
    </footer>
      </div>

    <div class="drawer-side z-[60]">
      <label for="landing-drawer" aria-label="close sidebar" class="drawer-overlay bg-black/60 backdrop-blur-sm"></label>
      <ul class="menu p-6 w-80 min-h-full border-l border-cyan-500/20 bg-white/[0.06] backdrop-blur-2xl text-white flex flex-col gap-2 shadow-neon-cyan">
        <li class="mb-4">
           <div class="flex items-center gap-2">
             <div class="h-8 w-8 rounded-lg bg-cyan-500/15 border border-cyan-400/35 flex items-center justify-center font-bold text-sm text-cyan-200 shadow-neon-cyan">F</div>
             <span class="text-xl font-bold tracking-tight text-white forge-text-glow">DevForge</span>
           </div>
        </li>
        <li><a href="#features" class="text-lg rounded-lg hover:bg-cyan-500/10 hover:text-cyan-200">Fonctionnalités</a></li>
        <li><a href="#stack" class="text-lg rounded-lg hover:bg-cyan-500/10 hover:text-cyan-200">Stack</a></li>
        <li><a href="#pricing" class="text-lg rounded-lg hover:bg-cyan-500/10 hover:text-cyan-200">Tarifs</a></li>
        <div class="divider border-cyan-500/15 before:bg-transparent after:bg-transparent"></div>
        <li><a href="/docker" class="text-lg rounded-lg hover:bg-cyan-500/10 hover:text-cyan-200">Supervision Docker</a></li>
        <li><a href="/login" class="text-lg rounded-lg hover:bg-white/[0.05]">Connexion</a></li>
        <li>
          <a href="/apps" class="mt-4 no-underline rounded-xl border border-cyan-400/40 bg-cyan-500/15 py-3 text-center font-semibold text-cyan-50 hover:bg-cyan-500/25 shadow-neon-cyan">
            Accéder au Dashboard
          </a>
        </li>
      </ul>
    </div>
    </div>
  </body>
</html>
